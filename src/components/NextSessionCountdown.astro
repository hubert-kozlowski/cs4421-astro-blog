---
import type { NflGame } from '../utils/nfl-data';
import { isAbsoluteTimestamp } from '../utils/local-game-time';

interface Props {
	games: NflGame[];
}

const { games } = Astro.props;
const sessionsByKickoff = new Map<string, string[]>();
for (const game of games) {
	const kickoffAt = game.kickoff_at ?? undefined;
	if (!isAbsoluteTimestamp(kickoffAt)) continue;
	const teams = `${game.away_team ?? 'Away'} @ ${game.home_team ?? 'Home'}`;
	const teamsAtKickoff = sessionsByKickoff.get(kickoffAt) ?? [];
	teamsAtKickoff.push(teams);
	sessionsByKickoff.set(kickoffAt, teamsAtKickoff);
}

const sessions = [...sessionsByKickoff]
	.map(([kickoffAt, matchups]) => ({ kickoffAt, matchups }))
	.sort((left, right) => Date.parse(left.kickoffAt) - Date.parse(right.kickoffAt));
const firstSession = sessions[0];
const initialRemaining = firstSession
	? Math.max(0, Date.parse(firstSession.kickoffAt) - Date.now())
	: 0;
const initialCountdown = [
	Math.floor(initialRemaining / 3_600_000),
	Math.floor((initialRemaining % 3_600_000) / 60_000),
	Math.floor((initialRemaining % 60_000) / 1000),
]
	.map((part) => String(part).padStart(2, '0'))
	.join(':');
---

<section class="next-session" aria-labelledby="next-session-heading" data-next-session-shell>
	<div class="next-session__intro">
		<span class="next-session__pulse" aria-hidden="true"></span>
		<div>
			<p class="eyebrow">NEXT KICKOFF</p>
			<h2 id="next-session-heading">Next session starts in</h2>
		</div>
	</div>
	{firstSession ? (
		<div class="next-session__timing" data-next-session data-sessions={JSON.stringify(sessions)}>
			<strong class="next-session__countdown" data-countdown>{initialCountdown}</strong>
			<span class="next-session__details">
				<time data-kickoff-time data-device-time="time" datetime={firstSession.kickoffAt}>Kickoff time</time>
				<span> · </span>
				<span data-session-matchups>
					{firstSession.matchups.length} game{firstSession.matchups.length === 1 ? '' : 's'}
				</span>
			</span>
		</div>
	) : (
		<p class="next-session__unavailable">Kickoff times are unavailable right now.</p>
	)}
</section>

<script>
	import '../scripts/next-session-countdown';
</script>

<style>
	.next-session {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin: 0 0 10px;
		padding: 8px 16px;
		border: 0;
		border-top: 1px solid rgb(255 255 255 / 12%);
		border-radius: 0 0 18px 18px;
		background:
			radial-gradient(ellipse at 100% 0%, rgb(145 173 221 / 20%), transparent 55%),
			linear-gradient(105deg, #111b30, #20375f);
		color: #fff;
	}

	.next-session[hidden] { display: none; }

	.next-session__intro {
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.next-session__pulse {
		width: 8px;
		height: 8px;
		flex: 0 0 auto;
		border-radius: 50%;
		background: var(--sport-accent);
		box-shadow: 0 0 0 4px rgb(201 41 58 / 20%);
	}

	.next-session .eyebrow {
		margin: 0 0 4px;
		color: #b5c6e5;
		font-size: 9px;
		letter-spacing: 0.11em;
	}

	.next-session h2 {
		margin: 0;
		font-size: 12px;
		font-weight: 650;
		letter-spacing: -0.02em;
	}

	.next-session__timing {
		display: flex;
		min-width: 0;
		align-items: baseline;
		gap: 12px;
		text-align: right;
	}

	.next-session__countdown {
		color: #fff;
		font-size: clamp(18px, 3vw, 24px);
		font-variant-numeric: tabular-nums;
		font-weight: 800;
		letter-spacing: 0.04em;
		line-height: 1;
		white-space: nowrap;
	}

	.next-session__details,
	.next-session__unavailable {
		min-width: 0;
		color: #c4d0e4;
		font-size: 11px;
		white-space: nowrap;
	}

	.next-session__details {
		flex: 1 1 auto;
	}

	.next-session__unavailable {
		margin: 0;
	}

	@media (max-width: 560px) {
		.next-session {
			min-height: 48px;
			gap: 8px;
			padding: 7px 11px;
		}

		.next-session__timing {
			margin-left: auto;
			gap: 7px;
		}

		.next-session__details {
			max-width: 105px;
			overflow: hidden;
			text-align: right;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.next-session .eyebrow { display: none; }
		.next-session h2 { font-size: 10px; white-space: nowrap; }
		.next-session__countdown { font-size: 17px; }
	}
</style>
