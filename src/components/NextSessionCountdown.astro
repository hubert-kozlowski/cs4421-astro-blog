---
import type { NflGame } from '../utils/nfl-data';

interface Props {
	games: NflGame[];
}

const { games } = Astro.props;
const sessionsByKickoff = new Map<string, string[]>();
for (const game of games) {
	if (!game.kickoff_at) continue;
	const teams = `${game.away_team ?? 'Away'} @ ${game.home_team ?? 'Home'}`;
	const teamsAtKickoff = sessionsByKickoff.get(game.kickoff_at) ?? [];
	teamsAtKickoff.push(teams);
	sessionsByKickoff.set(game.kickoff_at, teamsAtKickoff);
}

const sessions = [...sessionsByKickoff]
	.map(([kickoffAt, matchups]) => ({ kickoffAt, matchups }))
	.sort((left, right) => Date.parse(left.kickoffAt) - Date.parse(right.kickoffAt));
const firstSession = sessions[0];
const initialRemaining = firstSession
	? Math.max(0, Date.parse(firstSession.kickoffAt) - Date.now())
	: 0;
const initialCountdown = [
	Math.floor(initialRemaining / 3_600_000),
	Math.floor((initialRemaining % 3_600_000) / 60_000),
	Math.floor((initialRemaining % 60_000) / 1000),
]
	.map((part) => String(part).padStart(2, '0'))
	.join(':');
---

<section class="next-session" aria-labelledby="next-session-heading">
	<div class="next-session__intro">
		<span class="next-session__pulse" aria-hidden="true"></span>
		<div>
			<p class="eyebrow">THE NEXT KICKOFF WINDOW</p>
			<h2 id="next-session-heading">Next session starts in</h2>
		</div>
	</div>
	{firstSession ? (
		<div class="next-session__timing" data-next-session data-sessions={JSON.stringify(sessions)}>
			<strong class="next-session__countdown" data-countdown>{initialCountdown}</strong>
			<span class="next-session__details">
				<time data-kickoff-time datetime={firstSession.kickoffAt}>
					{new Date(firstSession.kickoffAt).toLocaleTimeString('en-US', {
						hour: 'numeric',
						minute: '2-digit',
					})}
				</time>
				<span> · </span>
				<span data-session-matchups>
					{firstSession.matchups.length} game{firstSession.matchups.length === 1 ? '' : 's'}
				</span>
			</span>
		</div>
	) : (
		<p class="next-session__unavailable">Kickoff times are unavailable right now.</p>
	)}
</section>

<script>
	import '../scripts/next-session-countdown';
</script>

<style>
	.next-session {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin: 0 0 15px;
		padding: 15px 19px;
		border: 1px solid #dbe5f5;
		border-radius: 0 0 16px 16px;
		background:
			radial-gradient(ellipse at 100% 0%, rgb(145 173 221 / 20%), transparent 55%),
			linear-gradient(105deg, #111b30, #20375f);
		color: #fff;
	}

	.next-session__intro {
		display: flex;
		align-items: center;
		gap: 11px;
	}

	.next-session__pulse {
		width: 10px;
		height: 10px;
		flex: 0 0 auto;
		border-radius: 50%;
		background: #f0bd65;
		box-shadow: 0 0 0 5px rgb(240 189 101 / 15%);
	}

	.next-session .eyebrow {
		margin: 0 0 4px;
		color: #b5c6e5;
		font-size: 9px;
		letter-spacing: 0.11em;
	}

	.next-session h2 {
		margin: 0;
		font-size: 14px;
		font-weight: 650;
		letter-spacing: -0.02em;
	}

	.next-session__timing {
		display: flex;
		min-width: 0;
		align-items: baseline;
		gap: 12px;
		text-align: right;
	}

	.next-session__countdown {
		color: #fff;
		font-size: clamp(24px, 4vw, 35px);
		font-variant-numeric: tabular-nums;
		font-weight: 800;
		letter-spacing: 0.04em;
		line-height: 1;
		white-space: nowrap;
	}

	.next-session__details,
	.next-session__unavailable {
		min-width: 0;
		color: #c4d0e4;
		font-size: 11px;
		white-space: nowrap;
	}

	.next-session__details {
		flex: 1 1 auto;
	}

	.next-session__unavailable {
		margin: 0;
	}

	@media (max-width: 560px) {
		.next-session {
			align-items: flex-start;
			flex-direction: column;
			gap: 12px;
		}

		.next-session__timing {
			width: 100%;
			justify-content: space-between;
		}

		.next-session__details {
			overflow-wrap: anywhere;
			text-align: right;
			white-space: normal;
		}
	}
</style>
