---
import { SITE_TITLE } from '../consts';

const navigation = [
	{ href: '/games', label: 'Games', key: 'games' },
	{ href: '/standings', label: 'Standings', key: 'standings' },
	{ href: '/teams', label: 'Teams', key: 'teams' },
	{ href: '/players', label: 'Players', key: 'players' },
	{ href: '/compare', label: 'Compare', key: 'compare' },
];

const pathname = Astro.url.pathname;
const activeKey =
	pathname === '/' || pathname.startsWith('/games')
		? 'games'
		: navigation.find(({ href }) => pathname === href || pathname.startsWith(`${href}/`))?.key;
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand__mark" aria-hidden="true">N</span>
			<span class="brand__name">NFL <span>WEEKEND</span></span>
		</a>
		<nav class="primary-nav" aria-label="Main navigation">
			{
				navigation.map(({ href, label, key }) => (
					<a
						class:list={['primary-nav__link', { 'is-active': activeKey === key }]}
						href={href}
						aria-current={activeKey === key ? 'page' : undefined}
					>
						{label}
					</a>
				))
			}
		</nav>
		<div class="site-header__season" aria-label="Data source status">
			<span class="status-dot" aria-hidden="true"></span>
			<span>Data setup</span>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		z-index: 10;
		top: 0;
		border-bottom: 1px solid rgb(230 232 236 / 80%);
		background: rgb(255 255 255 / 90%);
		backdrop-filter: saturate(180%) blur(20px);
	}

	.site-header__inner {
		display: flex;
		width: min(100% - 48px, 1180px);
		height: 72px;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		margin: 0 auto;
	}

	.brand {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 10px;
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand__mark {
		display: grid;
		width: 33px;
		height: 33px;
		place-items: center;
		border-radius: 10px;
		background: var(--color-navy);
		color: #fff;
		font-size: 15px;
		font-weight: 800;
		letter-spacing: -0.07em;
	}

	.brand__name {
		font-size: 13px;
		font-weight: 800;
		letter-spacing: -0.025em;
		white-space: nowrap;
	}

	.brand__name span {
		margin-left: 3px;
		color: var(--color-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.11em;
	}

	.primary-nav {
		display: flex;
		height: 100%;
		align-items: center;
		gap: 4px;
	}

	.primary-nav__link {
		display: inline-flex;
		height: 38px;
		align-items: center;
		padding: 0 13px;
		border-radius: 10px;
		color: var(--color-muted);
		font-size: 13px;
		font-weight: 550;
		text-decoration: none;
		transition:
			background-color 150ms ease,
			color 150ms ease;
	}

	.primary-nav__link:hover {
		background: #f3f4f6;
		color: var(--color-ink);
	}

	.primary-nav__link.is-active {
		background: #f0f2f5;
		color: var(--color-ink);
		font-weight: 650;
	}

	.site-header__season {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 8px;
		color: var(--color-muted);
		font-size: 12px;
		font-weight: 550;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #d59b43;
	}

	@media (max-width: 780px) {
		.site-header__inner {
			width: min(100% - 32px, 1180px);
			height: auto;
			min-height: 68px;
			flex-wrap: wrap;
			gap: 0 12px;
			padding-top: 12px;
		}

		.primary-nav {
			order: 3;
			width: 100%;
			height: 48px;
			overflow-x: auto;
			gap: 2px;
			margin: 0 -4px;
			scrollbar-width: none;
		}

		.primary-nav::-webkit-scrollbar {
			display: none;
		}

		.primary-nav__link {
			height: 34px;
			padding: 0 11px;
			font-size: 12px;
		}
	}
</style>
