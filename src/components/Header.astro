---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isGame = path.startsWith('/games/');
const isPlayer = path.startsWith('/players');
const isTeam = path.startsWith('/teams');
const isCompare = path === '/compare';
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand__mark" aria-hidden="true">GA</span>
			<span class="brand__name">GRIDIRON <span>ATLAS</span></span>
		</a>
		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="/#schedule" data-nav-section="schedule" aria-current={isGame ? 'page' : undefined}>Games</a>
			<a href="/#standings" data-nav-section="standings">Standings</a>
			<a href="/players" aria-current={isPlayer ? 'page' : undefined}>Players</a>
			<details class="more-menu">
				<summary aria-label="More destinations">More<span class="menu-chevron" aria-hidden="true"></span></summary>
				<div class="more-menu__panel">
					<a href="/teams" aria-current={isTeam ? 'page' : undefined}>Teams</a>
					<a href="/compare" aria-current={isCompare ? 'page' : undefined}>Compare teams</a>
				</div>
			</details>
		</nav>
		<details class="mobile-more more-menu">
			<summary aria-label="Open more destinations">More<span class="menu-chevron" aria-hidden="true"></span></summary>
			<div class="more-menu__panel">
				<a href="/teams" aria-current={isTeam ? 'page' : undefined}>Teams</a>
				<a href="/compare" aria-current={isCompare ? 'page' : undefined}>Compare teams</a>
			</div>
		</details>
	</div>
</header>

<nav class="mobile-nav" aria-label="App navigation" data-mobile-nav>
	<a href="/" data-mobile-nav-item="home" aria-current={path === '/' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
		<span>Home</span>
	</a>
	<a href="/#schedule" data-mobile-nav-item="schedule" aria-current={isGame ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14v14H5zM8 3v6m8-6v6M5 10h14" /></svg>
		<span>Games</span>
	</a>
	<a href="/#standings" data-mobile-nav-item="standings">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20v-6h4v6m2 0V5h4v15m2 0v-10h3v10" /></svg>
		<span>Standings</span>
	</a>
	<a href="/players" data-mobile-nav-item="players" aria-current={isPlayer ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3" /><path d="M6 20c.4-4 2.4-6 6-6s5.6 2 6 6" /></svg>
		<span>Players</span>
	</a>
</nav>

<script>
	const standaloneNavigator = navigator as Navigator & { standalone?: boolean };
	const standalone = window.matchMedia('(display-mode: standalone)').matches || standaloneNavigator.standalone === true;
	document.documentElement.dataset.displayMode = standalone ? 'standalone' : 'browser';
</script>

{path === '/' && (
	<script>
		const navItems = [...document.querySelectorAll<HTMLElement>('[data-mobile-nav-item]')];
		let activeName = '';
		const setActive = (name: string) => {
			if (name === activeName) return;
			activeName = name;
			navItems.forEach((item) => {
				if (item.dataset.mobileNavItem === name) item.setAttribute('aria-current', 'page');
				else item.removeAttribute('aria-current');
			});
		};
		const sections = ['schedule', 'standings', 'players']
			.map((id) => document.getElementById(id))
			.filter((section): section is HTMLElement => Boolean(section));
		const activeSection = () => {
			if (window.scrollY < 100) return 'home';
			const activationLine = Math.max(150, Math.min(window.innerHeight * 0.45, 380));
			let current = 'home';
			for (const section of sections) {
				if (section.getBoundingClientRect().top > activationLine) break;
				current = section.id;
			}
			const finalSection = sections.at(-1);
			if (finalSection && finalSection.getBoundingClientRect().top <= window.innerHeight * 0.65) {
				current = finalSection.id;
			}
			return current;
		};
		let updateFrame: number | undefined;
		const updateActiveSection = () => {
			updateFrame = undefined;
			setActive(activeSection());
		};
		const queueActiveSectionUpdate = () => {
			if (updateFrame !== undefined) return;
			updateFrame = window.requestAnimationFrame(updateActiveSection);
		};
		navItems.forEach((item) => {
			item.addEventListener('click', () => {
				const destination = item.dataset.mobileNavItem;
				if (destination) setActive(destination);
			});
		});
		window.addEventListener('scroll', queueActiveSectionUpdate, { passive: true });
		window.addEventListener('resize', queueActiveSectionUpdate, { passive: true });
		window.addEventListener('hashchange', queueActiveSectionUpdate);
		queueActiveSectionUpdate();
	</script>
)}

<style>
	.site-header { position: sticky; z-index: 20; top: 0; border-bottom: 1px solid rgb(230 232 236 / 85%); background: rgb(255 255 255 / 94%); backdrop-filter: saturate(180%) blur(20px); }
	.site-header__inner { display: flex; width: min(100% - 48px, 1120px); min-height: 62px; align-items: center; justify-content: space-between; gap: 20px; margin: 0 auto; }
	.brand { display: inline-flex; align-items: center; gap: 9px; color: var(--color-ink); text-decoration: none; }
	.brand__mark { position: relative; display: grid; width: 34px; height: 34px; overflow: hidden; place-items: center; border-radius: 10px; background: linear-gradient(145deg, #17233b, #304e80); box-shadow: 0 4px 10px rgb(28 50 88 / 20%); color: #fff; font-size: 15px; font-weight: 800; letter-spacing: -0.07em; }
	.brand__mark::after { position: absolute; right: 0; bottom: 0; width: 12px; height: 12px; background: var(--sport-accent); clip-path: polygon(100% 0, 0 100%, 100% 100%); content: ""; }
	.brand__name { font-size: 12px; font-weight: 800; letter-spacing: 0.04em; white-space: nowrap; }
	.brand__name span { color: var(--color-muted); font-weight: 600; }
	.desktop-nav { display: flex; align-items: center; gap: 3px; }
	.desktop-nav > a, .more-menu > summary, .more-menu__panel a { display: flex; min-height: 44px; align-items: center; padding: 0 11px; border-radius: 9px; color: var(--color-muted); font-size: 12px; font-weight: 650; text-decoration: none; cursor: pointer; }
	.desktop-nav a:hover, .desktop-nav a[aria-current="page"], .more-menu > summary:hover { background: var(--sport-accent-soft); color: var(--sport-accent-strong); }
	.more-menu { position: relative; }
	.more-menu > summary { list-style: none; }
	.more-menu > summary::-webkit-details-marker { display: none; }
	.menu-chevron { display: block; width: 6px; height: 6px; flex: 0 0 auto; margin: -3px 1px 0 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); transition: margin 140ms ease, transform 140ms ease; }
	.more-menu[open] > summary .menu-chevron { margin-top: 3px; transform: rotate(225deg); }
	.more-menu__panel { position: absolute; top: calc(100% + 7px); right: 0; z-index: 30; display: grid; min-width: 150px; padding: 6px; border: 1px solid var(--color-border); border-radius: 12px; background: #fff; box-shadow: 0 15px 35px rgb(20 29 48 / 14%); }
	.more-menu__panel a[aria-current="page"] { color: var(--sport-accent-strong); background: var(--sport-accent-soft); }
	.mobile-more, .mobile-nav { display: none; }

	@media (max-width: 640px) {
		.site-header__inner { width: min(100% - 28px, 1120px); min-height: 56px; }
		.desktop-nav { display: none; }
		.mobile-more { display: block; }
		.mobile-more > summary { min-height: 44px; padding: 0 8px; font-size: 11px; }
		.mobile-nav {
			position: fixed;
			right: 0;
			bottom: 0;
			left: 0;
			z-index: 25;
			isolation: isolate;
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			box-sizing: border-box;
			width: 100%;
			max-width: none;
			min-height: 62px;
			margin: 0 auto;
			overflow: hidden;
			padding: 5px max(10px, env(safe-area-inset-right)) max(5px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));
			border: 0;
			border-top: 1px solid rgb(210 215 225 / 72%);
			border-radius: 0;
			background:
				linear-gradient(180deg, rgb(255 255 255 / 91%), rgb(247 249 252 / 86%));
			box-shadow:
				0 -1px 8px rgb(17 27 48 / 7%),
				inset 0 1px 0 rgb(255 255 255 / 88%),
				inset 0 -1px 0 rgb(125 138 162 / 12%);
			-webkit-backdrop-filter: saturate(180%) blur(26px);
			backdrop-filter: saturate(180%) blur(26px);
		}
		.mobile-nav::before {
			display: none;
		}
		.mobile-nav a {
			position: relative;
			z-index: 1;
			display: grid;
			min-height: 50px;
			place-items: center;
			align-content: center;
			gap: 1px;
			border: 1px solid transparent;
			border-radius: 18px;
			color: #747b88;
			font-size: 9px;
			font-weight: 700;
			text-decoration: none;
			transition: color 160ms ease, background 160ms ease, box-shadow 160ms ease, transform 160ms ease;
		}
		.mobile-nav a[aria-current="page"] {
			border-color: rgb(255 255 255 / 78%);
			background:
				linear-gradient(145deg, rgb(255 255 255 / 84%), rgb(255 255 255 / 46%)),
				var(--sport-accent-soft);
			box-shadow:
				0 5px 14px rgb(25 35 55 / 10%),
				inset 0 1px 0 rgb(255 255 255 / 92%);
			color: var(--sport-accent);
		}
		.mobile-nav a:active { transform: scale(.96); }
		.mobile-nav svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; }

		:global(html[data-display-mode="standalone"]) .mobile-nav {
				right: max(18px, env(safe-area-inset-right));
				bottom: max(12px, env(safe-area-inset-bottom));
				left: max(18px, env(safe-area-inset-left));
				width: auto;
				max-width: 430px;
				padding: 5px;
				border: 1px solid rgb(255 255 255 / 72%);
				border-radius: 24px;
				background: linear-gradient(135deg, rgb(255 255 255 / 78%), rgb(247 249 252 / 62%));
				box-shadow:
					0 14px 32px rgb(17 27 48 / 14%),
					0 3px 10px rgb(17 27 48 / 8%),
					inset 0 1px 0 rgb(255 255 255 / 88%),
					inset 0 -1px 0 rgb(125 138 162 / 12%);
		}

		:global(html[data-display-mode="standalone"]) .mobile-nav::before {
				position: absolute;
				z-index: -1;
				top: -18px;
				right: 10%;
				left: 10%;
				display: block;
				height: 34px;
				border-radius: 50%;
				background: rgb(255 255 255 / 48%);
				filter: blur(12px);
				content: "";
				pointer-events: none;
		}
	}
</style>
