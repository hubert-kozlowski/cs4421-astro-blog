---
import { SITE_TITLE } from '../consts';

const sections = [
	{ href: '#schedule', label: 'Games' },
	{ href: '#standings', label: 'Standings' },
	{ href: '#players', label: 'Players' },
	{ href: '#matchups', label: 'Matchups' },
];
const onHome = Astro.url.pathname === '/';
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand__mark" aria-hidden="true">GA</span>
			<span class="brand__name">GRIDIRON <span>ATLAS</span></span>
		</a>
		{!onHome && (
			<nav class="quick-nav" aria-label="Dashboard sections">
				{sections.map(({ href, label }) => (
					<a class="quick-nav__link" href={`/${href}`}>{label}</a>
				))}
			</nav>
		)}
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		z-index: 10;
		top: 0;
		border-bottom: 1px solid rgb(230 232 236 / 80%);
		background: rgb(255 255 255 / 93%);
		backdrop-filter: saturate(180%) blur(20px);
	}

	.site-header__inner {
		display: flex;
		width: min(100% - 48px, 1180px);
		min-height: 72px;
		align-items: center;
		justify-content: space-between;
		gap: 22px;
		margin: 0 auto;
	}

	.brand {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 10px;
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand__mark {
		display: grid;
		width: 35px;
		height: 35px;
		place-items: center;
		border-radius: 11px;
		background: linear-gradient(145deg, #17233b, #304e80);
		box-shadow: 0 4px 10px rgb(28 50 88 / 20%);
		color: #fff;
		font-size: 16px;
		font-weight: 800;
		letter-spacing: -0.07em;
	}

	.brand__name {
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.brand__name span {
		color: var(--color-muted);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.quick-nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.quick-nav__link {
		display: inline-flex;
		min-height: 36px;
		align-items: center;
		padding: 0 12px;
		border-radius: 10px;
		color: var(--color-muted);
		font-size: 12px;
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color 150ms ease,
			color 150ms ease;
	}

	.quick-nav__link:hover {
		background: #f0f3f8;
		color: var(--color-blue);
	}

	@media (max-width: 900px) {
		.site-header__inner {
			width: min(100% - 32px, 1180px);
			flex-wrap: wrap;
			gap: 8px 14px;
			padding: 12px 0;
		}

		.quick-nav {
			order: 3;
			width: 100%;
			overflow-x: auto;
			margin: 0 -6px;
			scrollbar-width: none;
		}

		.quick-nav::-webkit-scrollbar {
			display: none;
		}

		.quick-nav__link {
			min-height: 32px;
			padding: 0 10px;
			font-size: 11px;
			white-space: nowrap;
		}
	}

</style>
