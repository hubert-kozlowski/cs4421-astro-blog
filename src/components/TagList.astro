---
import { slugifyTag } from '../utils/tags';

interface Props {
	tags?: string[];
}

const { tags } = Astro.props;
---

{
	tags && tags.length > 0 && (
		<ul class="tag-list">
			{tags.map((tag) => (
				<li>
					<a href={`/tags/${slugifyTag(tag)}/`}>
						<span class="hash">#</span>
						{tag}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		list-style: none;
		margin: 0.5em 0;
		padding: 0;
	}
	.tag-list a {
		display: inline-flex;
		align-items: center;
		gap: 0.15em;
		padding: 0.25em 0.8em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: rgba(var(--gray-light), 0.6);
		color: rgb(var(--gray-dark));
		font-size: 0.8em;
		font-weight: 500;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.15s ease,
			box-shadow 0.2s ease;
	}
	.tag-list .hash {
		opacity: 0.6;
	}
	.tag-list a:hover,
	.tag-list a:focus-visible {
		background: var(--accent);
		border-color: var(--accent);
		color: white;
		transform: translateY(-1px);
		box-shadow: 0 2px 6px rgba(var(--gray-dark), 0.15);
	}
	.tag-list a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.tag-list a:hover .hash,
	.tag-list a:focus-visible .hash {
		opacity: 0.85;
	}
</style>
