---
import { getGameBroadcastLabel, type NflGame, type NflTeam } from '../utils/nfl-data';
import { isAbsoluteTimestamp } from '../utils/local-game-time';
import { createGameCalendarEvent } from '../utils/calendar';
import CalendarActions from './CalendarActions.astro';

interface Props {
	games: NflGame[];
	teams: NflTeam[];
}

const { games, teams } = Astro.props;
---

<section class="upcoming" aria-labelledby="upcoming-heading">
	<div class="upcoming__heading">
		<p class="eyebrow">UP NEXT</p>
		<h3 id="upcoming-heading">The soonest games</h3>
	</div>
	<div class="upcoming__ticker" role="list">
		{games.map((game) => {
			const kickoffAt = game.kickoff_at && isAbsoluteTimestamp(game.kickoff_at) ? game.kickoff_at : undefined;
			const calendarEvent = createGameCalendarEvent(game, teams);
			return (
				<article class="upcoming-game" role="listitem">
					<a class="upcoming-game__link" href={`/games/${encodeURIComponent(game.game_id)}`}>
						{kickoffAt ? (
							<time class="upcoming-game__date" datetime={kickoffAt} data-device-time="time">Kickoff time</time>
						) : (
							<span class="upcoming-game__date">Kickoff time pending</span>
						)}
						<strong>{game.away_team} <i>@</i> {game.home_team}</strong>
						{getGameBroadcastLabel(game) && <span class="upcoming-game__broadcast">{getGameBroadcastLabel(game)}</span>}
					</a>
					{calendarEvent && <CalendarActions event={calendarEvent} compact />}
				</article>
			);
		})}
	</div>
</section>

<style>
	.upcoming {
		display: flex;
		align-items: center;
		gap: 20px;
		margin: 0 0 16px;
		padding: 13px 15px;
		border: 1px solid #e5eaf3;
		border-radius: 15px;
		background: linear-gradient(105deg, #f7f9fe, #fff);
	}

	.upcoming__heading {
		flex: 0 0 auto;
	}

	.upcoming__heading .eyebrow {
		margin: 0 0 3px;
		color: #6c7890;
		font-size: 9px;
	}

	.upcoming__heading h3 {
		margin: 0;
		font-size: 12px;
		white-space: nowrap;
	}

	.upcoming__ticker {
		display: flex;
		min-width: 0;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: thin;
	}

	.upcoming-game {
		min-width: 210px;
		border: 1px solid #e8ebf1;
		border-radius: 10px;
		background: #fff;
	}

	.upcoming-game:hover {
		border-color: #aebfe0;
		background: #fdfdff;
	}

	.upcoming-game__link {
		display: grid;
		gap: 4px;
		padding: 8px 10px;
		color: var(--color-ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.upcoming-game :global(.calendar-actions--compact) {
		padding: 8px 10px 10px;
	}

	.upcoming-game__date {
		color: var(--color-blue);
		font-size: 9px;
		font-weight: 750;
	}

	.upcoming-game strong {
		font-size: 11px;
	}

	.upcoming-game strong i {
		color: #8a91a0;
		font-size: 9px;
		font-style: normal;
	}

	.upcoming-game__broadcast {
		color: #8d6425;
		font-size: 8px;
		font-weight: 700;
	}

	@media (max-width: 560px) {
		.upcoming {
			align-items: flex-start;
			flex-direction: column;
			gap: 9px;
		}

		.upcoming__ticker {
			width: 100%;
		}
	}
</style>
