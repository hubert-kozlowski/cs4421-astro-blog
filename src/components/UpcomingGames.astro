---
import { getGameBroadcastLabel, type NflGame } from '../utils/nfl-data';

interface Props {
	games: NflGame[];
}

const { games } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const todayTime = Date.parse(`${today}T00:00:00Z`);

function dateLabel(gameday: string | null | undefined): string {
	if (!gameday) return 'Date pending';
	const dayOffset = (Date.parse(`${gameday}T00:00:00Z`) - todayTime) / 86_400_000;
	if (dayOffset === 0) return 'Today';
	if (dayOffset === 1) return 'Tomorrow';
	return new Date(`${gameday}T00:00:00Z`).toLocaleDateString('en-US', {
		weekday: 'short',
		month: 'short',
		day: 'numeric',
		timeZone: 'UTC',
	});
}
---

<section class="upcoming" aria-labelledby="upcoming-heading">
	<div class="upcoming__heading">
		<p class="eyebrow">UP NEXT</p>
		<h3 id="upcoming-heading">The soonest games</h3>
	</div>
	<div class="upcoming__ticker" role="list">
		{games.map((game) => (
			<a
				class="upcoming-game"
				href={`/games/${encodeURIComponent(game.game_id)}`}
				aria-label={`${dateLabel(game.gameday)}: ${game.away_team} at ${game.home_team}${getGameBroadcastLabel(game) ? `, ${getGameBroadcastLabel(game)}` : ''}`}
				role="listitem"
			>
				<span class="upcoming-game__date">{dateLabel(game.gameday)}</span>
				<strong>{game.away_team} <i>@</i> {game.home_team}</strong>
				{getGameBroadcastLabel(game) && <span class="upcoming-game__broadcast">{getGameBroadcastLabel(game)}</span>}
			</a>
		))}
	</div>
</section>

<style>
	.upcoming {
		display: flex;
		align-items: center;
		gap: 20px;
		margin: 0 0 16px;
		padding: 13px 15px;
		border: 1px solid #e5eaf3;
		border-radius: 15px;
		background: linear-gradient(105deg, #f7f9fe, #fff);
	}

	.upcoming__heading {
		flex: 0 0 auto;
	}

	.upcoming__heading .eyebrow {
		margin: 0 0 3px;
		color: #6c7890;
		font-size: 9px;
	}

	.upcoming__heading h3 {
		margin: 0;
		font-size: 12px;
		white-space: nowrap;
	}

	.upcoming__ticker {
		display: flex;
		min-width: 0;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: thin;
	}

	.upcoming-game {
		display: grid;
		min-width: 112px;
		gap: 4px;
		padding: 8px 10px;
		border: 1px solid #e8ebf1;
		border-radius: 10px;
		background: #fff;
		color: var(--color-ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.upcoming-game:hover {
		border-color: #aebfe0;
		background: #fdfdff;
	}

	.upcoming-game__date {
		color: var(--color-blue);
		font-size: 9px;
		font-weight: 750;
	}

	.upcoming-game strong {
		font-size: 11px;
	}

	.upcoming-game strong i {
		color: #8a91a0;
		font-size: 9px;
		font-style: normal;
	}

	.upcoming-game__broadcast {
		color: #8d6425;
		font-size: 8px;
		font-weight: 700;
	}

	@media (max-width: 560px) {
		.upcoming {
			align-items: flex-start;
			flex-direction: column;
			gap: 9px;
		}

		.upcoming__ticker {
			width: 100%;
		}
	}
</style>
