---
import { getGameBroadcastLabel, type NflGame } from '../utils/nfl-data';
import { isAbsoluteTimestamp } from '../utils/local-game-time';

interface Props {
	games: NflGame[];
}

const { games } = Astro.props;
---

<section class="upcoming" aria-labelledby="upcoming-heading">
	<div class="upcoming__heading">
		<p class="eyebrow">UP NEXT</p>
		<h3 id="upcoming-heading">The soonest games</h3>
	</div>
	<div class="upcoming__ticker" role="list">
		{games.map((game) => {
			const kickoffAt = game.kickoff_at && isAbsoluteTimestamp(game.kickoff_at) ? game.kickoff_at : undefined;
			return (
				<a
					class="upcoming-game"
					href={`/games/${encodeURIComponent(game.game_id)}`}
					role="listitem"
				>
					{kickoffAt ? (
						<time class="upcoming-game__date" datetime={kickoffAt} data-device-time="time">Kickoff time</time>
					) : (
						<span class="upcoming-game__date">Kickoff time pending</span>
					)}
					<strong>{game.away_team} <i>@</i> {game.home_team}</strong>
					{getGameBroadcastLabel(game) && <span class="upcoming-game__broadcast">{getGameBroadcastLabel(game)}</span>}
				</a>
			);
		})}
	</div>
</section>

<style>
	.upcoming {
		display: flex;
		align-items: center;
		gap: 16px;
		margin: 0 0 18px;
		padding: 11px 12px 11px 15px;
		border: 1px solid color-mix(in srgb, var(--sport-accent) 20%, #dfe5ef);
		border-radius: 14px;
		background: linear-gradient(105deg, var(--sport-accent-soft), #fff 42%);
		box-shadow: 0 7px 18px rgba(25, 42, 72, 0.04);
	}

	.upcoming__heading {
		flex: 0 0 auto;
	}

	.upcoming__heading .eyebrow {
		margin: 0 0 3px;
		color: #6c7890;
		font-size: 9px;
	}

	.upcoming__heading h3 {
		margin: 0;
		font-size: 12px;
		white-space: nowrap;
	}

	.upcoming__ticker {
		display: flex;
		min-width: 0;
		gap: 8px;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
	}

	.upcoming-game {
		display: grid;
		min-width: 180px;
		gap: 4px;
		padding: 8px 11px;
		border: 1px solid #e4e9f1;
		border-radius: 9px;
		background: #fff;
		color: var(--color-ink);
		text-decoration: none;
		white-space: nowrap;
		scroll-snap-align: start;
		transition: border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
	}

	.upcoming-game:hover {
		border-color: var(--sport-accent);
		box-shadow: 0 5px 13px rgba(25, 42, 72, 0.09);
		transform: translateY(-1px);
	}

	.upcoming-game__date {
		color: var(--color-blue);
		font-size: 9px;
		font-weight: 750;
	}

	.upcoming-game strong {
		font-size: 11px;
	}

	.upcoming-game strong i {
		color: #8a91a0;
		font-size: 9px;
		font-style: normal;
	}

	.upcoming-game__broadcast {
		color: #8d6425;
		font-size: 8px;
		font-weight: 700;
	}

	@media (max-width: 560px) {
		.upcoming {
			align-items: flex-start;
			flex-direction: column;
			gap: 9px;
		}

		.upcoming__ticker {
			width: 100%;
		}
	}
</style>
