---
import { getStadiumProfile } from '../utils/stadium-profiles';

interface Props {
	label?: string;
	homeTeamName: string;
	homeTeamAbbr?: string | null;
}

const { label, homeTeamName, homeTeamAbbr = '' } = Astro.props;

const teamStyles: Record<string, { primary: string; accent: string; city: string; setting: string }> = {
	ARI: { primary: '#97233f', accent: '#ffb612', city: 'Glendale, Arizona', setting: 'desert' },
	ATL: { primary: '#a71930', accent: '#a5acaf', city: 'Atlanta, Georgia', setting: 'city' },
	BAL: { primary: '#241773', accent: '#9e7c0c', city: 'Baltimore, Maryland', setting: 'coast' },
	BUF: { primary: '#00338d', accent: '#c60c30', city: 'Orchard Park, New York', setting: 'lake' },
	CAR: { primary: '#0085ca', accent: '#101820', city: 'Charlotte, North Carolina', setting: 'woodland' },
	CHI: { primary: '#0b162a', accent: '#c83803', city: 'Chicago, Illinois', setting: 'lake' },
	CIN: { primary: '#fb4f14', accent: '#111111', city: 'Cincinnati, Ohio', setting: 'river' },
	CLE: { primary: '#311d00', accent: '#ff3c00', city: 'Cleveland, Ohio', setting: 'lake' },
	DAL: { primary: '#003594', accent: '#869397', city: 'Arlington, Texas', setting: 'plains' },
	DEN: { primary: '#fb4f14', accent: '#002244', city: 'Denver, Colorado', setting: 'mountain' },
	DET: { primary: '#0076b6', accent: '#b0b7bc', city: 'Detroit, Michigan', setting: 'lake' },
	GB: { primary: '#203731', accent: '#ffb612', city: 'Green Bay, Wisconsin', setting: 'woodland' },
	HOU: { primary: '#03202f', accent: '#a71930', city: 'Houston, Texas', setting: 'plains' },
	IND: { primary: '#002c5f', accent: '#a2aaad', city: 'Indianapolis, Indiana', setting: 'city' },
	JAX: { primary: '#006778', accent: '#d7a22a', city: 'Jacksonville, Florida', setting: 'coast' },
	KC: { primary: '#e31837', accent: '#ffb81c', city: 'Kansas City, Missouri', setting: 'plains' },
	LV: { primary: '#111111', accent: '#a5acaf', city: 'Las Vegas, Nevada', setting: 'desert' },
	LAC: { primary: '#0080c6', accent: '#ffc20e', city: 'Inglewood, California', setting: 'coast' },
	LAR: { primary: '#003594', accent: '#ffa300', city: 'Inglewood, California', setting: 'coast' },
	LA: { primary: '#003594', accent: '#ffa300', city: 'Inglewood, California', setting: 'coast' },
	MIA: { primary: '#008e97', accent: '#fc4c02', city: 'Miami Gardens, Florida', setting: 'coast' },
	MIN: { primary: '#4f2683', accent: '#ffc62f', city: 'Minneapolis, Minnesota', setting: 'lake' },
	NE: { primary: '#002244', accent: '#c60c30', city: 'Foxborough, Massachusetts', setting: 'woodland' },
	NO: { primary: '#d3bc8d', accent: '#101820', city: 'New Orleans, Louisiana', setting: 'river' },
	NYG: { primary: '#0b2265', accent: '#a71930', city: 'East Rutherford, New Jersey', setting: 'city' },
	NYJ: { primary: '#125740', accent: '#ffffff', city: 'East Rutherford, New Jersey', setting: 'city' },
	PHI: { primary: '#004c54', accent: '#a5acaf', city: 'Philadelphia, Pennsylvania', setting: 'river' },
	PIT: { primary: '#ffb612', accent: '#101820', city: 'Pittsburgh, Pennsylvania', setting: 'river' },
	SEA: { primary: '#002244', accent: '#69be28', city: 'Seattle, Washington', setting: 'rain' },
	SF: { primary: '#aa0000', accent: '#b3995d', city: 'Santa Clara, California', setting: 'coast' },
	TB: { primary: '#d50a0a', accent: '#34302b', city: 'Tampa, Florida', setting: 'coast' },
	TEN: { primary: '#0c2340', accent: '#4b92db', city: 'Nashville, Tennessee', setting: 'river' },
	WAS: { primary: '#5a1414', accent: '#ffb612', city: 'Landover, Maryland', setting: 'woodland' },
};

const style = teamStyles[homeTeamAbbr ?? ''] ?? {
	primary: '#28446f',
	accent: '#9fb0c8',
	city: 'United States',
	setting: 'city',
};
const stadiumProfile = getStadiumProfile(homeTeamAbbr);
const venueLabel = label ?? stadiumProfile.venue;
const terrain = style.setting === 'desert'
	? 'M8 99 Q31 80 55 99 T102 99 M255 99 Q287 76 320 99 T352 99'
	: style.setting === 'mountain'
		? 'M8 100 58 55 91 87 132 43 190 100 M232 100 281 51 352 100'
		: style.setting === 'woodland' || style.setting === 'rain'
			? 'M14 96 29 69 44 96m3 0 15-27 15 27m219 0 15-27 15 27m3 0 15-27 15 27'
			: style.setting === 'lake' || style.setting === 'coast'
				? 'M8 87q19-10 38 0t38 0m-76 13q19-10 38 0t38 0m216-13q19-10 38 0t38 0m-76 13q19-10 38 0t38 0'
				: 'M8 96h50m244 0h50';
const isLightAccent = ['ARI', 'GB', 'KC', 'MIN', 'NO', 'NYJ', 'PIT', 'SF', 'WAS'].includes(homeTeamAbbr ?? '');
const teamLabel = homeTeamName.replace(/^the /i, '');
---

<svg
	class="stadium-diagram"
	viewBox="0 0 360 190"
	data-stadium-team={homeTeamAbbr}
	role="img"
	aria-label={`Top-down illustration of ${venueLabel}, home of the ${teamLabel} in ${style.city}`}
>
	<rect x="5" y="5" width="350" height="180" rx="34" fill="#e8edf3" />
	<text x="180" y="19" text-anchor="middle" fill="#526177" font-size="7" font-weight="800" letter-spacing=".8">
		HOME TEAM · {homeTeamAbbr || 'NFL'} · {style.city.toUpperCase()}
	</text>
	<defs>
		<clipPath id="stadium-backdrop-clip" clipPathUnits="userSpaceOnUse">
			<rect x="5" y="5" width="350" height="180" rx="34" />
		</clipPath>
	</defs>
	<g clip-path="url(#stadium-backdrop-clip)">
		<path d={terrain} fill="none" stroke={style.accent} stroke-opacity=".68" stroke-width="3" stroke-linecap="round" />
		{style.setting === 'desert' && <circle cx="307" cy="41" r="11" fill="#ffcf70" />}
		{style.setting === 'rain' && (
			<path d="m75 39-4 11m13-11-4 11m13-11-4 11m180-11-4 11m13-11-4 11m13-11-4 11" stroke="#78a5c8" stroke-linecap="round" stroke-width="2" />
		)}
	</g>
	<defs>
		<clipPath id="stadium-outline-clip" clipPathUnits="userSpaceOnUse">
			<path d={stadiumProfile.outline} />
		</clipPath>
	</defs>
	<g transform="translate(0 18) scale(1 .88)">
		<path data-motion-stadium-outline d={stadiumProfile.outline} fill="#fff" stroke={style.primary} stroke-width="7" />
		<g clip-path="url(#stadium-outline-clip)">
			{stadiumProfile.details && (
				<path class="stadium-architecture" d={stadiumProfile.details} fill="none" stroke={style.primary} stroke-opacity=".35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			)}
			<rect data-stadium-field x="96" y="58" width="168" height="74" rx="2" fill="#3c795c" />
			<rect x="96" y="58" width="18" height="74" rx="1" fill={style.primary} />
			<rect x="246" y="58" width="18" height="74" rx="1" fill={style.accent} />
			<text transform="rotate(-90 100 95)" x="100" y="95" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-size="7" font-weight="800">{homeTeamAbbr}</text>
			<text transform="rotate(90 260 95)" x="260" y="95" text-anchor="middle" dominant-baseline="middle" fill={isLightAccent ? '#202733' : '#fff'} font-size="7" font-weight="800">{homeTeamAbbr}</text>
			{Array.from({ length: 11 }, (_, index) => 114 + index * 13.2).map((x) => (
				<path data-motion-yard-line d={`M${x} 60v70`} stroke="#ffffff" stroke-opacity=".45" stroke-width="1.5" />
			))}
			<path data-motion-yard-line d="M96 62h168M96 128h168" stroke="#ffffff" stroke-opacity=".65" stroke-width="2" />
			<circle cx="180" cy="95" r="10" fill="none" stroke="#ffffff" stroke-opacity=".75" stroke-width="2" />
			<path d="M180 58v74" stroke="#ffffff" stroke-opacity=".75" stroke-width="2" />
			<g
				class="stadium-live-ball"
				data-stadium-live-ball
				role="img"
				aria-label="Live ball position"
				style="display: none"
			>
				<path data-stadium-live-ball-marker d="M-3 91 2 95 -3 99" />
			</g>
		</g>
	</g>
</svg>

<style>
	.stadium-diagram {
		display: block;
		width: 100%;
		height: auto;
	}

	.stadium-live-ball {
		fill: none;
		stroke: #ffd16c;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2.5;
		filter: drop-shadow(0 1px 1px rgb(20 30 42 / 70%));
	}

	.stadium-architecture {
		pointer-events: none;
	}
</style>
