---
interface Props {
	label?: string;
}

const { label = 'Football stadium' } = Astro.props;
const yardLines = Array.from({ length: 9 }, (_, index) => 68 + index * 28);
---

<svg
	class="stadium-diagram"
	viewBox="0 0 360 190"
	role="img"
	aria-label={`Top-down illustration of ${label}`}
>
	<rect x="8" y="8" width="344" height="174" rx="38" fill="#dfe7f1" />
	<rect x="19" y="19" width="322" height="152" rx="32" fill="#c4d0df" />
	<path d="M48 30h264a22 22 0 0 1 22 22v86a22 22 0 0 1-22 22H48a22 22 0 0 1-22-22V52a22 22 0 0 1 22-22Z" fill="#17243a" />
	<path d="M65 42h230a14 14 0 0 1 14 14v78a14 14 0 0 1-14 14H65a14 14 0 0 1-14-14V56a14 14 0 0 1 14-14Z" fill="#3c795c" />
	<rect x="51" y="64" width="24" height="62" rx="2" fill="#244f46" />
	<rect x="285" y="64" width="24" height="62" rx="2" fill="#244f46" />
	{yardLines.map((x) => <path d={`M${x} 43v110`} stroke="#ffffff" stroke-opacity=".42" stroke-width="1.5" />)}
	<path d="M51 48h258M51 142h258" stroke="#ffffff" stroke-opacity=".65" stroke-width="2" />
	<circle cx="180" cy="95" r="18" fill="none" stroke="#ffffff" stroke-opacity=".72" stroke-width="2" />
	<path d="M180 43v110" stroke="#ffffff" stroke-opacity=".72" stroke-width="2" />
	<path d="M31 49h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m274-91h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12m-12 8h12" stroke="#8e9fb4" stroke-linecap="round" stroke-width="2" />
</svg>

<style>
	.stadium-diagram {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
