---
import type { TeamRecord } from '../utils/nfl-data';
import { teamPalette } from '../utils/team-colors';
import TeamMark from './TeamMark.astro';

interface Props {
	records: TeamRecord[];
}

const { records } = Astro.props;
const teamStyle = (abbr: string) => {
	const colors = teamPalette(abbr);
	return colors ? `--team-primary: ${colors.primary}; --team-accent: ${colors.accent}` : undefined;
};
const conferences = [
	{ name: 'AFC', className: 'record-card--afc' },
	{ name: 'NFC', className: 'record-card--nfc' },
];
---

<div class="record-grid">
	{
		conferences.map(({ name, className }) => {
			const leaders = records
				.filter((record) => record.conf === name)
				.sort(
					(left, right) =>
						right.winPercentage - left.winPercentage ||
						right.wins - left.wins ||
						left.name.localeCompare(right.name),
				)
				.slice(0, 5);

			return (
				<section class:list={['record-card', className]} aria-label={`${name} standings snapshot`} data-standings-card>
					<header class="record-card__header">
						<span class="conference-badge">{name}</span>
						<span class="record-card__caption">Season snapshot</span>
						{leaders.length > 3 && <button type="button" data-record-toggle aria-expanded="false">Top 5</button>}
					</header>
					{
						leaders.length > 0 ? (
							<ol class="record-list">
								{leaders.map((team, index) => (
									<li data-record-extra={index >= 3 ? '' : undefined}>
										<span class="record-list__rank">{index + 1}</span>
										<a
											class="record-list__team"
											href={`/teams/${team.abbr}`}
											style={teamStyle(team.abbr)}
										>
											<TeamMark abbr={team.abbr} conference={team.conf} />
											<span class="record-list__name">{team.name}</span>
										</a>
										<span class="record-list__record">
											{team.wins}-{team.losses}
											{team.ties > 0 && `-${team.ties}`}
										</span>
										<span
											class="record-list__bar"
											aria-label={`${Math.round(team.winPercentage * 100)} percent win rate`}
										>
											<span
												style={`${teamStyle(team.abbr)}; width: ${Math.round(team.winPercentage * 100)}%`}
											></span>
										</span>
									</li>
								))}
							</ol>
						) : (
							<p class="record-empty">Standings will take shape as final game scores are added.</p>
						)
					}
				</section>
			);
		})
	}
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-record-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const card = button.closest<HTMLElement>('[data-standings-card]');
			const expanded = card?.classList.toggle('is-expanded') ?? false;
			button.setAttribute('aria-expanded', String(expanded));
			button.textContent = expanded ? 'Top 3' : 'Top 5';
		});
	});
</script>

<style>
	.record-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.record-card {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background: #fff;
	}

	.record-card__header {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 9px 12px;
		border-bottom: 1px solid #eef0f3;
	}

	.conference-badge {
		padding: 4px 8px;
		border-radius: 7px;
		background: #fff0f1;
		color: #ac2d3e;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.07em;
	}

	.record-card--nfc .conference-badge {
		background: var(--sport-accent-soft);
		color: var(--sport-accent-strong);
	}

	.record-card__caption {
		color: var(--color-muted);
		font-size: 11px;
		font-weight: 550;
	}

	.record-card__header button {
		min-width: 44px;
		min-height: 44px;
		margin-left: auto;
		margin-block: -9px;
		padding: 0 5px;
		border: 0;
		background: transparent;
		color: var(--sport-accent-strong);
		font-size: 9px;
		font-weight: 750;
		cursor: pointer;
	}

	.record-list {
		margin: 0;
		padding: 3px 12px 7px;
		list-style: none;
	}

	.record-list li {
		display: grid;
		grid-template-columns: 17px minmax(0, 1fr) auto 45px;
		align-items: center;
		gap: 9px;
		padding: 6px 0;
	}

	.record-list li[data-record-extra] { display: none; }
	.record-card.is-expanded .record-list li[data-record-extra] { display: grid; }

	.record-list__rank {
		color: var(--color-faint);
		font-size: 10px;
		font-weight: 700;
	}

	.record-list__team {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 8px;
		color: inherit;
		text-decoration: none;
	}

	.record-list__team :global(.team-mark__plate) {
		fill: var(--team-primary, #285b9f);
	}

	.record-list__team :global(.team-mark__stripe) {
		fill: var(--team-accent, #fff);
	}

	.record-list__team:hover .record-list__name {
		color: var(--sport-accent);
	}

	.record-list__name {
		overflow: hidden;
		font-size: 11px;
		font-weight: 600;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.record-list__record {
		color: var(--color-ink);
		font-size: 11px;
		font-weight: 750;
		font-variant-numeric: tabular-nums;
	}

	.record-list__bar {
		display: block;
		height: 4px;
		overflow: hidden;
		border-radius: 999px;
		background: #e8edf5;
	}

	.record-list__bar > span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--team-primary, #3c73c2);
	}

	.record-empty {
		margin: 0;
		padding: 20px 17px;
		color: var(--color-muted);
		font-size: 12px;
	}

	@media (max-width: 520px) {
		.record-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 7px;
		}

		.record-card__header { gap: 5px; padding: 7px; }
		.record-card__caption { display: none; }
		.record-list { padding: 2px 7px 6px; }
		.record-list li { grid-template-columns: 12px minmax(0, 1fr) auto; gap: 4px; padding: 5px 0; }
		.record-list__bar { display: none; }
		.record-list__team { gap: 3px; }
		.record-list__team :global(.team-mark) { width: 22px; height: 22px; }
		.record-list__name { display: none; }
		.record-list__record { font-size: 9px; }
		.conference-badge { padding: 3px 5px; font-size: 8px; }
		.record-card__header button { font-size: 8px; }
	}
</style>
