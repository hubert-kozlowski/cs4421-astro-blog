---
interface Props {
	body?: string;
}

const { body = '' } = Astro.props;

// Calculate reading time: 200 words = 1 minute, rounded up
const words = body.split(/\s+/).filter((word) => word.length > 0).length;
const minutes = Math.max(1, Math.ceil(words / 200)); // Minimum 1 minute
---

<div class="reading-time">
	{minutes} {minutes === 1 ? 'min' : 'mins'} read
</div>

<style>
	.reading-time {
		color: rgb(var(--gray));
		font-size: 0.85em;
		line-height: 1;
		display: inline-flex;
		gap: 0.25em;
		white-space: nowrap;
	}

	@media (max-width: 480px) {
		.reading-time {
			font-size: 0.8em;
		}
	}
</style>
