---
interface Props {
	homeTeam?: string;
	awayTeam?: string;
}

const { homeTeam, awayTeam } = Astro.props;
const isGamePage = Boolean(homeTeam && awayTeam);
---

<section
	class="live-center"
	aria-label={isGamePage ? 'Live game updates' : 'NFL games happening now'}
	data-live-center
	data-live-layout={isGamePage ? 'game-detail' : 'ticker'}
	data-game-home={homeTeam}
	data-game-away={awayTeam}
	hidden
>
	<div class="live-center__header">
		<span class="live-center__indicator"><i aria-hidden="true"></i> LIVE NOW</span>
		<span class="live-center__label">SCORES & GAME UPDATES</span>
		<span class="live-center__freshness" data-live-freshness></span>
	</div>
	<div class="live-center__games" data-live-games-list></div>
</section>

{isGamePage && (
	<section
		class="live-boxscore"
		data-live-boxscore
		data-game-home={homeTeam}
		data-game-away={awayTeam}
		hidden
		aria-label="Live game statistics"
	>
		<div class="live-boxscore__header">
			<div>
				<p class="eyebrow">LIVE BOX SCORE</p>
				<h2>Live game stats</h2>
			</div>
			<span class="live-boxscore__updated" data-live-updated></span>
		</div>
		<div data-live-stats></div>
	</section>
)}

<script>
	import '../scripts/live-game-updates';
</script>

<style>
	.live-center {
		margin: 12px 0 16px;
		overflow: hidden;
		border: 1px solid #e7e9ed;
		border-radius: 12px;
		background: linear-gradient(110deg, #fff, #fcfcfd);
		color: #292d35;
	}

	.live-center[hidden],
	.live-boxscore[hidden] {
		display: none;
	}

	.live-center__header {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 32px;
		padding: 5px 11px;
		border-bottom: 1px solid #f0f1f3;
	}

	.live-center__indicator {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #c33440;
		font-size: 9px;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.live-center__indicator i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #dc4953;
	}

	.live-center__label {
		color: #777d88;
		font-size: 9px;
		font-weight: 600;
	}

	.live-center__freshness {
		margin-left: auto;
		color: #858b95;
		font-size: 9px;
	}

	.live-center__games {
		display: grid;
	}

	.live-center :global(.live-game-row) {
		position: relative;
		display: grid;
		grid-template-columns: minmax(110px, 1fr) minmax(120px, 1.4fr) auto minmax(82px, 0.6fr);
		align-items: center;
		gap: 12px;
		min-height: 38px;
		padding: 5px 11px;
		border-bottom: 1px solid #f1f2f4;
		color: inherit;
		text-decoration: none;
	}

	.live-center :global(a.live-game-row) {
		cursor: pointer;
	}

	.live-center :global(a.live-game-row:focus-visible) {
		z-index: 2;
		outline: 2px solid #315f9a;
		outline-offset: -2px;
	}

	.live-center :global(.live-game-row > *) {
		position: relative;
		z-index: 1;
	}

	.live-center :global(.live-game-row--red-zone) {
		background: linear-gradient(100deg, rgb(255 240 239 / 88%), rgb(255 248 247 / 76%));
	}

	.live-center :global(.live-game-row--red-zone::before) {
		position: absolute;
		z-index: 0;
		top: 50%;
		right: 12px;
		color: #b8323c;
		content: "RED ZONE";
		font-size: clamp(20px, 4vw, 34px);
		font-weight: 900;
		letter-spacing: 0.12em;
		opacity: 0.07;
		pointer-events: none;
		transform: translateY(-50%);
		white-space: nowrap;
	}

	.live-center :global(.live-game-row__notice) {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		min-height: 18px;
		padding: 3px 8px;
		border-left: 3px solid transparent;
		border-radius: 2px;
		font-size: 8px;
		font-weight: 900;
		letter-spacing: 0.12em;
		line-height: 1;
	}

	.live-center :global(.live-game-row__notice--flag) {
		border-left-color: #bf8c0a;
		background: repeating-linear-gradient(135deg, #f7d46b 0, #f7d46b 8px, #f4cd57 8px, #f4cd57 16px);
		color: #342909;
	}

	.live-center :global(.live-game-row__notice--under_review) {
		border-left-color: #53647b;
		background: linear-gradient(100deg, #e9edf2, #f3f5f7);
		color: #2d3949;
	}

	.live-center :global(.live-game-row:last-child) {
		border-bottom: 0;
	}

	.live-center :global(.live-game-row__teams) {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 11px;
		font-weight: 750;
	}

	.live-center :global(.live-game-row__teams span) {
		color: #8a909a;
		font-size: 9px;
	}

	.live-center :global(.live-game-row__team) {
		padding-bottom: 1px;
	}

	.live-center :global(.live-game-row__team--possession) {
		border-bottom: 3px solid var(--possession-accent, #687385);
	}

	.live-center :global(.live-game-row__field) {
		display: block;
		width: 100%;
		max-width: 340px;
		height: 40px;
	}

	.live-center :global(.live-game-row__field-surface) {
		fill: #366b48;
		stroke: #244d34;
		stroke-width: 1;
	}

	.live-center :global(.live-game-row__field-endzone) {
		fill: #244d34;
	}

	.live-center :global(.live-game-row__field-endzone-label) {
		fill: #e6f2e7;
		font-size: 4px;
		font-weight: 800;
		text-anchor: middle;
	}

	.live-center :global(.live-game-row__field-direction) {
		fill: none;
		stroke: #ffd16c;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1;
	}

	.live-center :global(.live-game-row__field-mark) {
		stroke: #b7d2bb;
		stroke-width: 0.8;
	}

	.live-center :global(.live-game-row__field-yard) {
		fill: #edf5ed;
		font-size: 5px;
		font-weight: 700;
		text-anchor: middle;
	}

	.live-center :global(.live-game-row__field-hash) {
		stroke: #d2e4d5;
		stroke-width: 0.8;
	}

	.live-center :global(.live-game-row__field-ball-stem) {
		stroke: #c33440;
		stroke-width: 1.5;
	}

	.live-center :global(.live-game-row__field-ball) {
		fill: #f5b347;
		stroke: #472c0b;
		stroke-width: 0.8;
	}

	.live-center :global(.live-game-row__score) {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 15px;
		font-variant-numeric: tabular-nums;
		font-weight: 800;
	}

	.live-center :global(.live-game-row__score--changed) {
		animation: live-score-bump 700ms ease-out;
	}

	.live-center :global(.live-game-row__score span) {
		color: #a0a4ab;
		font-size: 10px;
	}

	.live-center :global(.live-game-row__clock) {
		color: #777d88;
		font-size: 9px;
		font-weight: 650;
		text-align: right;
	}

	.live-center :global(.live-game-row__situation) {
		grid-column: 1 / -1;
		margin: -2px 0 0;
		color: #868b94;
		font-size: 9px;
		line-height: 1.3;
	}

	.live-center :global(.live-game-row__play) {
		grid-column: 1 / -1;
		margin: 0;
		padding: 4px 7px;
		border-left: 2px solid #e0a8ad;
		background: #fff8f8;
		color: #626771;
		font-size: 9px;
		line-height: 1.35;
	}

	.live-center :global(.live-game-row__play--key) {
		border-left-color: #d94b55;
		background: #fff7f7;
		color: #42464f;
	}

	.live-center :global(.live-event-alert) {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		flex-wrap: wrap;
		gap: 4px 8px;
		margin: 1px 0 2px;
		padding: 7px 9px;
		border: 1px solid #f0d1d3;
		border-left: 3px solid #c33440;
		border-radius: 7px;
		background: linear-gradient(100deg, #fff6f5, #fffdfd);
		animation: live-event-arrive 220ms ease-out both;
	}

	.live-center :global(.live-event-alert__title) {
		color: #ad2e39;
		font-size: 9px;
		font-weight: 850;
		letter-spacing: 0.06em;
	}

	.live-center :global(.live-event-alert__score) {
		color: #282d36;
		font-size: 10px;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
	}

	.live-center :global(.live-event-alert__detail) {
		flex-basis: 100%;
		color: #636973;
		font-size: 9px;
		line-height: 1.35;
	}

	.live-boxscore {
		margin-top: 17px;
		padding: 24px;
		border: 1px solid #e3e6eb;
		border-radius: 18px;
		background: #fff;
		box-shadow: 0 10px 30px rgb(22 33 52 / 5%);
	}

	.live-boxscore__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 20px;
		padding-bottom: 14px;
		border-bottom: 1px solid #eceef1;
	}

	.live-boxscore__header .eyebrow {
		margin-bottom: 5px;
		color: #bd343e;
		font-size: 10px;
	}

	.live-boxscore__header h2 {
		margin: 0;
		font-size: 22px;
		letter-spacing: -0.04em;
	}

	.live-boxscore__updated {
		color: var(--color-muted);
		font-size: 10px;
	}

	.live-boxscore :global(.live-boxscore__teams) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.live-boxscore :global(.live-boxscore__team) {
		min-width: 0;
		padding: 18px;
		border: 1px solid #e6e9ee;
		border-radius: 14px;
		background: #fbfcfe;
	}

	.live-boxscore :global(.live-boxscore__team-heading) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 14px;
		padding-bottom: 10px;
		border-bottom: 2px solid #bd3540;
	}

	.live-boxscore :global(.live-boxscore__team-heading h3) {
		margin: 0;
		font-size: 18px;
		font-weight: 850;
		letter-spacing: -0.03em;
	}

	.live-boxscore :global(.live-boxscore__team-label) {
		color: #858c97;
		font-size: 9px;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.live-boxscore :global(.live-boxscore__totals) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
		margin: 0 0 18px;
	}

	.live-boxscore :global(.live-boxscore__metric) {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
		padding: 9px 3px;
		border-bottom: 1px solid #e5e8ed;
	}

	.live-boxscore :global(.live-boxscore__metric dt) {
		color: #626b78;
		font-size: 10px;
		font-weight: 650;
	}

	.live-boxscore :global(.live-boxscore__metric dd) {
		margin: 0;
		color: #1d2c42;
		font-size: 14px;
		font-variant-numeric: tabular-nums;
		font-weight: 850;
	}

	.live-boxscore :global(.live-boxscore__category) {
		margin-top: 17px;
	}

	.live-boxscore :global(.live-boxscore__category h4) {
		margin: 0 0 8px;
		color: #465367;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.live-boxscore :global(.live-boxscore__table-wrap) {
		overflow-x: auto;
	}

	.live-boxscore :global(.live-boxscore__table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 11px;
		text-align: left;
	}

	.live-boxscore :global(.live-boxscore__table caption) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.live-boxscore :global(.live-boxscore__table thead) {
		background: #eef1f5;
		color: #576274;
		font-size: 9px;
		letter-spacing: 0.06em;
	}

	.live-boxscore :global(.live-boxscore__table th),
	.live-boxscore :global(.live-boxscore__table td) {
		padding: 9px 8px;
		border-bottom: 1px solid #e9ecf0;
		white-space: nowrap;
	}

	.live-boxscore :global(.live-boxscore__table tbody th) {
		color: #2e3745;
		font-weight: 700;
	}

	.live-boxscore :global(.live-boxscore__table td),
	.live-boxscore :global(.live-boxscore__table thead th:not(:first-child)) {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.live-boxscore :global(.live-boxscore__table tbody tr:nth-child(even)) {
		background: #f7f8fa;
	}

	.live-boxscore :global(.live-boxscore__empty) {
		margin: 0;
		color: var(--color-muted);
		font-size: 12px;
	}

	@keyframes live-score-bump {
		45% {
			color: #bd3540;
			transform: scale(1.15);
		}
	}

	@keyframes live-event-arrive {
		0% {
			opacity: 0;
			transform: translateY(-4px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.live-center :global(.live-game-row__score--changed),
		.live-center :global(.live-event-alert) {
			animation: none;
		}
	}

	@media (max-width: 600px) {
		.live-center :global(.live-game-row) {
			grid-template-columns: minmax(75px, 1fr) auto auto;
			gap: 8px;
		}

		.live-center :global(.live-game-row__teams) {
			grid-column: 1;
		}

		.live-center :global(.live-game-row__score) {
			grid-column: 2;
			grid-row: 1;
		}

		.live-center :global(.live-game-row__clock) {
			grid-column: 3;
			grid-row: 1;
		}

		.live-center :global(.live-game-row__field) {
			grid-column: 1 / -1;
			grid-row: 2;
			max-width: none;
		}

		.live-center :global(.live-game-row__situation) {
			grid-row: 3;
		}

		.live-center :global(.live-game-row__play) {
			grid-column: 1 / -1;
		}

		.live-boxscore {
			padding: 17px;
		}

		.live-boxscore :global(.live-boxscore__teams) {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.live-boxscore :global(.live-boxscore__team) {
			padding: 14px;
		}

		.live-boxscore :global(.live-boxscore__header h2) {
			font-size: 19px;
		}
	}
</style>
