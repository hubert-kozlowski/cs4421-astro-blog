---
import DataFreshness from '../components/DataFreshness.astro';
import DataState from '../components/DataState.astro';
import GameRow from '../components/GameRow.astro';
import TeamMark from '../components/TeamMark.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { compareTeams, getApiMetadata, type ApiResult, type HeadToHead, type NflTeam } from '../utils/nfl-data';
import { getTeamDisplayName } from '../utils/team-names';

const requestedTeam1 = Astro.url.searchParams.get('team1')?.trim().toUpperCase() ?? '';
const requestedTeam2 = Astro.url.searchParams.get('team2')?.trim().toUpperCase() ?? '';
let teams: NflTeam[] = [];
let metadataUnavailable = false;
let result: ApiResult<HeadToHead> | undefined;
let providerUnavailable = false;
let validationMessage = '';

try {
	teams = (await getApiMetadata()).value.teams;
} catch (error) {
	metadataUnavailable = true;
	console.error(JSON.stringify({
		level: 'error',
		event: 'compare_metadata_unavailable',
		error: error instanceof Error ? error.name : 'UnknownError',
	}));
}

const teamIds = new Set(teams.map((team) => team.abbr));
const hasSelection = Boolean(requestedTeam1 || requestedTeam2);
if (hasSelection) {
	if (!requestedTeam1 || !requestedTeam2) validationMessage = 'Choose two teams to compare.';
	else if (requestedTeam1 === requestedTeam2) validationMessage = 'Choose two different teams.';
	else if (!teamIds.has(requestedTeam1) || !teamIds.has(requestedTeam2)) validationMessage = 'Choose teams from the NFL directory.';
	else {
		try {
			result = await compareTeams(requestedTeam1, requestedTeam2);
		} catch (error) {
			providerUnavailable = true;
			console.error(JSON.stringify({
				level: 'error',
				event: 'team_comparison_unavailable',
				error: error instanceof Error ? error.name : 'UnknownError',
			}));
		}
	}
}

const firstRecord = result?.value.record[requestedTeam1];
const secondRecord = result?.value.record[requestedTeam2];
---

<SiteLayout title="Compare teams" description="Compare NFL teams and their recent head-to-head games.">
	<header class="page-heading compare-heading">
		<p class="eyebrow">HEAD TO HEAD</p>
		<h1>Compare teams.</h1>
		<p>Choose two teams for their all-time matchup record and five most recent meetings.</p>
	</header>

	<form class="compare-form" action="/compare" method="get">
		<label for="compare-team-1">First team</label>
		<select id="compare-team-1" name="team1" required disabled={metadataUnavailable}>
			<option value="">Choose a team</option>
			{teams.map((team) => <option value={team.abbr} selected={team.abbr === requestedTeam1}>{team.name}</option>)}
		</select>
		<span aria-hidden="true">VS</span>
		<label for="compare-team-2">Second team</label>
		<select id="compare-team-2" name="team2" required disabled={metadataUnavailable}>
			<option value="">Choose a team</option>
			{teams.map((team) => <option value={team.abbr} selected={team.abbr === requestedTeam2}>{team.name}</option>)}
		</select>
		<button type="submit" disabled={metadataUnavailable}>Compare</button>
	</form>

	{validationMessage && <p class="compare-message" role="alert">{validationMessage}</p>}
	{metadataUnavailable && <DataState state="error" title="Team comparison is unavailable" description="The NFL team directory could not be loaded. Please try again." />}
	{providerUnavailable && <DataState state="error" title="The matchup could not load" description="The historical game provider is temporarily unavailable. Please try again." />}

	{result && (
		<section class="comparison-result" aria-labelledby="comparison-result-title">
			<header class="comparison-scoreboard">
				<div class="comparison-team">
					<TeamMark abbr={requestedTeam1} size="medium" />
					<strong>{getTeamDisplayName(requestedTeam1)}</strong>
					<span>{firstRecord?.wins ?? 0} wins</span>
				</div>
				<div class="comparison-total">
					<span>{result.value.total_games} meetings</span>
					<h2 id="comparison-result-title">{firstRecord?.wins ?? 0}–{secondRecord?.wins ?? 0}</h2>
					<small>{(firstRecord?.ties ?? 0) > 0 ? `${firstRecord?.ties} ties` : 'Head to head'}</small>
				</div>
				<div class="comparison-team comparison-team--right">
					<TeamMark abbr={requestedTeam2} size="medium" />
					<strong>{getTeamDisplayName(requestedTeam2)}</strong>
					<span>{secondRecord?.wins ?? 0} wins</span>
				</div>
			</header>
			<div class="comparison-meta"><strong>Recent meetings</strong><DataFreshness fetchedAt={result.fetchedAt} stale={result.stale} /></div>
			{result.value.games.length > 0 ? (
				<div class="comparison-games">
					{result.value.games.slice(0, 5).map((game) => <GameRow game={game} teams={teams} />)}
				</div>
			) : (
				<DataState title="No meetings found" description="The provider has no head-to-head games for this pairing." />
			)}
		</section>
	)}

	{!hasSelection && !metadataUnavailable && (
		<div class="compare-prompt">
			<strong>Pick a matchup</strong>
			<span>Historical records will appear here.</span>
		</div>
	)}
</SiteLayout>

<style>
	.compare-heading { margin-bottom: 18px; }
	.compare-form { display: grid; grid-template-columns: auto minmax(150px, 1fr) auto auto minmax(150px, 1fr) auto; align-items: center; gap: 9px; padding: 11px; border: 1px solid var(--color-border); border-radius: 15px; background: #fff; }
	.compare-form label { color: var(--color-muted); font-size: 10px; font-weight: 700; }
	.compare-form > span { color: var(--sport-accent); font-size: 9px; font-weight: 850; }
	.compare-form select { min-height: 44px; padding: 0 10px; border: 1px solid var(--color-border); border-radius: 10px; background: #fff; }
	.compare-form button { min-height: 44px; padding: 0 17px; border: 0; border-radius: 10px; background: var(--sport-accent); color: var(--sport-on-accent); font-size: 11px; font-weight: 750; cursor: pointer; }
	.compare-form button:hover { background: var(--sport-accent-strong); }
	.compare-form :disabled { cursor: not-allowed; opacity: .55; }
	.compare-message { margin: 10px 0 0; color: var(--sport-accent-strong); font-size: 12px; }
	.comparison-result { margin-top: 16px; }
	.comparison-scoreboard { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; padding: 18px; border-radius: 17px; background: linear-gradient(120deg, #111a2e, #25385f); color: #fff; }
	.comparison-team { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 2px 10px; }
	.comparison-team :global(.team-mark) { grid-row: 1 / 3; }
	.comparison-team strong { overflow: hidden; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
	.comparison-team span { color: #bdc9da; font-size: 10px; }
	.comparison-team--right { grid-template-columns: minmax(0, 1fr) auto; text-align: right; }
	.comparison-team--right :global(.team-mark) { grid-column: 2; }
	.comparison-team--right strong, .comparison-team--right span { grid-column: 1; }
	.comparison-total { text-align: center; }
	.comparison-total span, .comparison-total small { color: #bdc9da; font-size: 9px; }
	.comparison-total h2 { margin: 2px 0; font-size: 27px; }
	.comparison-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 15px 0 8px; font-size: 12px; }
	.comparison-games { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
	.compare-prompt { display: grid; min-height: 180px; place-content: center; justify-items: center; gap: 4px; margin-top: 16px; border: 1px dashed #d9dde5; border-radius: 16px; color: var(--color-muted); font-size: 12px; }
	.compare-prompt strong { color: var(--color-ink); font-size: 14px; }

	@media (max-width: 700px) {
		.compare-form { grid-template-columns: 1fr auto 1fr; gap: 7px; }
		.compare-form label { display: none; }
		.compare-form button { grid-column: 1 / -1; }
	}
	@media (max-width: 560px) {
		.compare-heading { margin-bottom: 12px; }
		.compare-form { padding: 8px; }
		.compare-form select { min-width: 0; width: 100%; font-size: 11px; }
		.comparison-scoreboard { gap: 8px; padding: 13px 10px; }
		.comparison-team { grid-template-columns: 1fr; justify-items: center; text-align: center; }
		.comparison-team :global(.team-mark) { grid-row: auto; }
		.comparison-team--right { grid-template-columns: 1fr; }
		.comparison-team--right :global(.team-mark), .comparison-team--right strong, .comparison-team--right span { grid-column: auto; }
		.comparison-team strong { max-width: 95px; font-size: 10px; }
		.comparison-games { grid-template-columns: 1fr; }
	}
</style>
