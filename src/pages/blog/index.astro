---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import TagList from '../../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { slugifyTag } from '../../utils/tags';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Unique tags across all posts, keyed by slug so filter pills can dedupe case/spacing variants.
const tagsBySlug = new Map<string, string>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagsBySlug.set(slugifyTag(tag), tag);
	}
}
const uniqueTags = [...tagsBySlug.entries()].sort((a, b) => a[1].localeCompare(b[1]));

// Pre-filter server-side from the URL so a shared/bookmarked link works before JS loads.
const selectedTags = new Set(
	(Astro.url.searchParams.get('tags') ?? '')
		.split(',')
		.map((tag) => tag.trim())
		.filter(Boolean),
);
function matchesSelectedTags(post: (typeof posts)[number]) {
	if (selectedTags.size === 0) return true;
	const postTagSlugs = new Set((post.data.tags ?? []).map(slugifyTag));
	return [...selectedTags].every((tag) => postTagSlugs.has(tag));
}
const hasVisiblePosts = posts.some(matchesSelectedTags);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.tag-filter-bar {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75em;
				margin-bottom: 2.5rem;
				padding: 0.9em 0 1.1em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.tag-filter-tags {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5em;
			}
			.tag-filter-actions {
				display: flex;
				align-items: center;
				margin-left: auto;
			}
			.tag-filter-label {
				margin: 0 0.2em 0 0;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.tag-filter-pill {
				padding: 0.35em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: transparent;
				color: rgb(var(--gray-dark));
				font-size: 0.9em;
				cursor: pointer;
				transition:
					background-color 0.2s ease,
					color 0.2s ease,
					transform 0.15s ease,
					box-shadow 0.2s ease;
			}
			.tag-filter-pill:hover {
				border-color: var(--accent);
				transform: translateY(-1px);
			}
			.tag-filter-pill:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
			.tag-filter-pill[aria-pressed='true'] {
				background: var(--accent);
				border-color: var(--accent);
				color: white;
				box-shadow: 0 2px 6px rgba(var(--gray-dark), 0.2);
			}
			#clear-tag-filters {
				border: none;
				background: none;
				color: rgb(var(--gray));
				text-decoration: underline;
				cursor: pointer;
				font-size: 0.85em;
				transition: color 0.2s ease;
			}
			#clear-tag-filters:hover,
			#clear-tag-filters:focus-visible {
				color: var(--accent);
			}
			#no-results {
				display: none;
				color: rgb(var(--gray));
				font-style: italic;
				padding: 2rem 0;
				text-align: center;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{
				uniqueTags.length > 0 && (
					<div class="tag-filter-bar" role="group" aria-label="Filter posts by tag">
						<div class="tag-filter-tags">
							<span class="tag-filter-label">Filter by tag</span>
							{uniqueTags.map(([slug, label]) => (
								<button
									type="button"
									class="tag-filter-pill"
									data-tag={slug}
									aria-pressed={selectedTags.has(slug) ? 'true' : 'false'}
								>
									{label}
								</button>
							))}
						</div>
						<div class="tag-filter-actions">
							<button type="button" id="clear-tag-filters">
								Clear filters
							</button>
						</div>
					</div>
				)
			}
			<section>
				<p id="no-results" style={hasVisiblePosts ? undefined : 'display: block'}>
					No posts match the selected tags.
				</p>
				<ul id="post-list">
					{
						posts.map((post) => (
							<li
								data-tags={(post.data.tags ?? []).map(slugifyTag).join(',')}
								style={matchesSelectedTags(post) ? undefined : 'display: none'}
							>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
								<TagList tags={post.data.tags} />
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			const filterBar = document.querySelector('.tag-filter-bar');
			const postList = document.getElementById('post-list');
			const noResults = document.getElementById('no-results');
			if (filterBar && postList) {
				const pills = [...filterBar.querySelectorAll<HTMLButtonElement>('.tag-filter-pill')];
				const items = [...postList.querySelectorAll<HTMLLIElement>('li[data-tags]')];
				const selected = new Set(
					pills.filter((pill) => pill.getAttribute('aria-pressed') === 'true').map((pill) => pill.dataset.tag!),
				);

				function applyFilter() {
					let visibleCount = 0;
					for (const item of items) {
						const postTags = new Set((item.dataset.tags ?? '').split(',').filter(Boolean));
						const isVisible = selected.size === 0 || [...selected].every((tag) => postTags.has(tag));
						item.style.display = isVisible ? '' : 'none';
						if (isVisible) visibleCount++;
					}
					if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
					const url = new URL(window.location.href);
					if (selected.size > 0) {
						url.searchParams.set('tags', [...selected].join(','));
					} else {
						url.searchParams.delete('tags');
					}
					window.history.replaceState({}, '', url);
				}

				for (const pill of pills) {
					pill.addEventListener('click', () => {
						const tag = pill.dataset.tag!;
						if (selected.has(tag)) {
							selected.delete(tag);
							pill.setAttribute('aria-pressed', 'false');
						} else {
							selected.add(tag);
							pill.setAttribute('aria-pressed', 'true');
						}
						applyFilter();
					});
				}

				document.getElementById('clear-tag-filters')?.addEventListener('click', () => {
					selected.clear();
					for (const pill of pills) pill.setAttribute('aria-pressed', 'false');
					applyFilter();
				});
			}
		</script>
	</body>
</html>
