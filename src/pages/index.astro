---
import DataFreshness from '../components/DataFreshness.astro';
import DataState from '../components/DataState.astro';
import GameRow from '../components/GameRow.astro';
import { isAbsoluteTimestamp } from '../utils/local-game-time';
import { getTeamDisplayName } from '../utils/team-names';
import LiveGameCenter from '../components/LiveGameCenter.astro';
import NextSessionCountdown from '../components/NextSessionCountdown.astro';
import PlayerAvatar from '../components/PlayerAvatar.astro';
import RecordBoard from '../components/RecordBoard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
	getDashboardData,
	searchPlayersWithSuggestions,
	type ApiResult,
	type NflDashboardData,
	type PlayerSearchResult,
} from '../utils/nfl-data';

const searchParams = Astro.url.searchParams;
const requestedWeek = Number(searchParams.get('week'));
const requestedTeam = searchParams.get('team') ?? '';
const playerQuery = searchParams.get('player')?.trim() ?? '';

let dashboardResult: ApiResult<NflDashboardData> | undefined;
let dashboardError = false;
try {
	dashboardResult = await getDashboardData(Number.isInteger(requestedWeek) ? requestedWeek : undefined);
} catch (error) {
	dashboardError = true;
	console.error(
		JSON.stringify({
			level: 'error',
			event: 'dashboard_data_unavailable',
			error: error instanceof Error ? error.name : 'UnknownError',
		}),
	);
}

const dashboard = dashboardResult?.value;
const teamFilter = dashboard?.teams.some((team) => team.abbr === requestedTeam) ? requestedTeam : '';
const visibleGames =
	dashboard?.games.filter(
		(game) => !teamFilter || game.home_team === teamFilter || game.away_team === teamFilter,
	).sort((left, right) => {
		const leftTime = isAbsoluteTimestamp(left.kickoff_at ?? undefined) ? Date.parse(left.kickoff_at!) : Number.MAX_SAFE_INTEGER;
		const rightTime = isAbsoluteTimestamp(right.kickoff_at ?? undefined) ? Date.parse(right.kickoff_at!) : Number.MAX_SAFE_INTEGER;
		return leftTime - rightTime || (left.gameday ?? '').localeCompare(right.gameday ?? '');
	}) ?? [];

let playerResults: PlayerSearchResult | undefined;
let playerError = false;
if (playerQuery.length >= 2) {
	try {
		playerResults = await searchPlayersWithSuggestions(playerQuery, 12);
	} catch (error) {
		playerError = true;
		console.error(
			JSON.stringify({
				level: 'error',
				event: 'player_search_unavailable',
				error: error instanceof Error ? error.name : 'UnknownError',
			}),
		);
	}
}

const firstKickoff = (dashboard?.countdownGames ?? [])
	.map((game) => game.kickoff_at ?? '')
	.filter((value) => isAbsoluteTimestamp(value))
	.sort()[0];
const firstFinalAt = firstKickoff ? new Date(Date.parse(firstKickoff) + 3.5 * 3_600_000).toISOString() : undefined;
const allRecords = dashboard?.records ?? [];
const recordsAvailable = allRecords.some((record) => record.gamesPlayed > 0);
---

<SiteLayout
	title="NFL dashboard"
	description="Follow NFL games, standings, team records, player profiles in one colorful dashboard."
>
	<section class="dashboard-hero">
		<div class="dashboard-hero__copy">
			<p class="eyebrow">NFL · {dashboard ? `WEEK ${dashboard.week}` : 'SEASON'}</p>
			<h1>Every game. <span>One place.</span></h1>
			<p class="dashboard-hero__lede">Scores, standings, and every matchup across the league.</p>
		</div>
	</section>
	<LiveGameCenter />
	{dashboard && <NextSessionCountdown games={dashboard.countdownGames} />}

	<section id="schedule" class="dashboard-section" aria-labelledby="schedule-heading">
		<div class="section-heading schedule-heading">
			<div>
				<p class="eyebrow">WEEKLY LINEUP</p>
				<h2 id="schedule-heading">Games</h2>
			</div>
			{dashboardResult && <DataFreshness fetchedAt={dashboardResult.fetchedAt} stale={dashboardResult.stale} />}
		</div>

		{dashboard && (
			<>
				<div class="schedule-toolbar schedule-toolbar--desktop">
					<form class="schedule-filter" action="/#schedule" method="get">
						<label for="week-filter-desktop">Week</label>
						<select id="week-filter-desktop" name="week">
							{dashboard.availableWeeks.map((week) => (
								<option value={week} selected={week === dashboard.week}>Week {week}</option>
							))}
						</select>
						<label for="team-filter-desktop">Team</label>
						<select id="team-filter-desktop" name="team">
							<option value="">All teams</option>
							{dashboard.teams.map((team) => (
								<option value={team.abbr} selected={team.abbr === teamFilter}>{getTeamDisplayName(team.abbr)}</option>
							))}
						</select>
						<button type="submit">Show games</button>
						<a class="browse-teams" href="/teams">Browse teams ↗</a>
					</form>
				</div>
				<div class="schedule-toolbar schedule-toolbar--mobile">
					<form class="mobile-week-filter" action="/#schedule" method="get">
						<label for="week-filter-mobile">Week</label>
						<select id="week-filter-mobile" name="week">
							{dashboard.availableWeeks.map((week) => <option value={week} selected={week === dashboard.week}>{week}</option>)}
						</select>
						{teamFilter && <input type="hidden" name="team" value={teamFilter} />}
						<button type="submit">Go</button>
					</form>
					<button class="team-filter-trigger" type="button" data-team-filter-open>
						<span>{teamFilter ? getTeamDisplayName(teamFilter) : 'All teams'}</span><span class="control-chevron" aria-hidden="true"></span>
					</button>
				</div>
				<dialog class="team-filter-sheet" data-team-filter-dialog aria-labelledby="team-filter-title">
					<form action="/#schedule" method="get">
						<div class="team-filter-sheet__handle" aria-hidden="true"></div>
						<div class="team-filter-sheet__header">
							<strong id="team-filter-title">Filter by team</strong>
							<button type="button" data-team-filter-close aria-label="Close team filter">×</button>
						</div>
						<input type="hidden" name="week" value={dashboard.week} />
						<label for="team-filter-mobile">Team</label>
						<select id="team-filter-mobile" name="team">
							<option value="">All teams</option>
							{dashboard.teams.map((team) => <option value={team.abbr} selected={team.abbr === teamFilter}>{getTeamDisplayName(team.abbr)}</option>)}
						</select>
						<button class="team-filter-apply" type="submit">Apply filter</button>
					</form>
				</dialog>
				{dashboard.stale && (
					<p class="stale-note">The provider is temporarily unavailable. Showing the last saved NFL data.</p>
				)}
				{visibleGames.length > 0 ? (
					<>
						<div class="game-grid" data-schedule-list>
							{visibleGames.map((game, index) => <GameRow game={game} teams={dashboard.teams} extra={index >= 6} />)}
						</div>
						{visibleGames.length > 6 && <button class="show-all-games" type="button" data-schedule-toggle aria-expanded="false">Show all {visibleGames.length} games</button>}
					</>
				) : (
					<DataState
						title={teamFilter ? `No ${getTeamDisplayName(teamFilter)} game in week ${dashboard.week}` : `No games listed for week ${dashboard.week}`}
						description="Choose another week or clear the team filter to see more of the schedule."
					/>
				)}
			</>
		)}
		{dashboardError && (
			<DataState
				state="error"
				title="The schedule could not load"
				description="We couldn’t reach the NFL data provider and there’s no saved schedule available. Try again later."
			/>
		)}
	</section>

	<section id="standings" class="dashboard-section" aria-labelledby="standings-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow">THE SEASON SO FAR</p>
				<h2 id="standings-heading">See who’s climbing.</h2>
			</div>
			<span class="section-kicker">AFC <i></i> NFC</span>
		</div>
		{recordsAvailable && dashboard ? (
			<RecordBoard records={allRecords} />
		) : dashboard ? (
			<div class="section-empty">
				<span class="empty-orb" aria-hidden="true">W–L</span>
				<div>
					<strong>Records will take shape after the first final.</strong>
					<p>The standings snapshot is calculated from completed regular-season games, not estimates.</p>
					{firstFinalAt && (
						<p class="first-final" data-first-final={firstFinalAt}>
							First finals expected in <time class="first-final__time" data-first-final-time>--:--:--</time>
						</p>
					)}
				</div>
			</div>
		) : (
			<DataState
				title="Standings are unavailable"
				description="The standings snapshot will return when season game data is available."
			/>
		)}
	</section>

	<section id="players" class="dashboard-section players-feature" aria-labelledby="players-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow">PLAYER SPOTLIGHT</p>
				<h2 id="players-heading">Find your player.</h2>
			</div>
			<a class="text-link" href="/players">Advanced search <span aria-hidden="true">↗</span></a>
		</div>
		<form class="player-search" action="/#players" method="get" role="search">
			<label class="sr-only" for="dashboard-player-search">Search NFL player names</label>
			<span aria-hidden="true">⌕</span>
			<input
				id="dashboard-player-search"
				type="search"
				name="player"
				value={playerQuery}
				minlength="2"
				placeholder="Try a name, like Patrick Mahomes"
				required
			/>
			<button type="submit">Search players</button>
		</form>
		{playerResults && (
			<>
				<p class="results-caption">
					{playerResults.suggested
						? `Closest matches for “${playerQuery}”`
						: `${playerResults.value.total} players found for “${playerQuery}”`}
					<DataFreshness fetchedAt={playerResults.fetchedAt} stale={playerResults.stale} />
				</p>
				<div class="player-grid">
					{playerResults.value.data.map((player) => (
						<a class="player-card" href={`/players/${encodeURIComponent(player.gsis_id)}`}>
							<PlayerAvatar name={player.display_name} />
							<span class="player-card__details">
								<span class:list={['position-pill', `position-pill--${(player.position ?? 'other').toLowerCase()}`]}>
									{player.position ?? 'NFL'}
								</span>
								<strong>{player.display_name}</strong>
								<span>{player.college ?? 'Player profile'}{player.years_exp ? ` · ${player.years_exp} seasons` : ''}</span>
							</span>
						</a>
					))}
				</div>
			</>
		)}
		{playerQuery.length > 0 && playerQuery.length < 2 && (
			<p class="inline-message">Enter at least two characters to search players.</p>
		)}
		{playerError && (
			<DataState
				state="error"
				title="Player search is unavailable"
				description="The NFL player directory could not be reached. Please try again."
			/>
		)}
		{playerResults?.value.data.length === 0 && (
			<DataState title="No players found" description="Try a different spelling or search with a shorter part of the name." />
		)}
	</section>
</SiteLayout>

<script src="../scripts/dashboard-motion.ts"></script>
<script>
	const countdown = document.querySelector<HTMLElement>('[data-first-final]');
	const target = Date.parse(countdown?.dataset.firstFinal ?? '');
	const output = countdown?.querySelector<HTMLElement>('[data-first-final-time]');
	if (countdown && output && Number.isFinite(target)) {
		const tick = () => {
			const remaining = Math.max(0, target - Date.now());
			const days = Math.floor(remaining / 86_400_000);
			const clock = [
				Math.floor((remaining % 86_400_000) / 3_600_000),
				Math.floor((remaining % 3_600_000) / 60_000),
				Math.floor((remaining % 60_000) / 1000),
			]
				.map((part) => String(part).padStart(2, '0'))
				.join(':');
			output.textContent = days > 0 ? `${days}d ${clock}` : clock;
			if (remaining === 0) window.clearInterval(timer);
		};
		const timer = window.setInterval(tick, 1000);
		tick();
	}
</script>
<script>
	import { animate, stagger } from 'motion';

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const heroCopy = document.querySelector<HTMLElement>('.dashboard-hero__copy');
		if (heroCopy) {
			heroCopy.dataset.motionPlayed = 'true';
			animate(
				heroCopy.querySelectorAll<HTMLElement>(':scope > .eyebrow, :scope > h1, :scope > p:last-child'),
				{ opacity: [0, 1], y: [12, 0] },
				{ duration: 0.5, delay: stagger(0.09), ease: 'easeOut' },
			);
		}
	}

	if (window.location.hash === '#players' && new URLSearchParams(window.location.search).has('player')) {
		document.querySelector('#players')?.scrollIntoView({ block: 'start', behavior: 'instant' });
	}
</script>
<script>
	const schedule = document.querySelector<HTMLElement>('[data-schedule-list]');
	const scheduleToggle = document.querySelector<HTMLButtonElement>('[data-schedule-toggle]');
	scheduleToggle?.addEventListener('click', () => {
		const expanded = schedule?.classList.toggle('is-expanded') ?? false;
		scheduleToggle.setAttribute('aria-expanded', String(expanded));
		scheduleToggle.textContent = expanded ? 'Show fewer games' : `Show all ${schedule?.children.length ?? ''} games`;
	});

	const teamDialog = document.querySelector<HTMLDialogElement>('[data-team-filter-dialog]');
	document.querySelector('[data-team-filter-open]')?.addEventListener('click', () => teamDialog?.showModal());
	document.querySelector('[data-team-filter-close]')?.addEventListener('click', () => teamDialog?.close());
	teamDialog?.addEventListener('click', (event) => {
		if (event.target === teamDialog) teamDialog.close();
	});

	const liveCenter = document.querySelector<HTMLElement>('[data-live-center]');
	const nextSession = document.querySelector<HTMLElement>('[data-next-session-shell]');
	if (liveCenter && nextSession) {
		const syncStatusStrip = () => { nextSession.hidden = !liveCenter.hidden; };
		new MutationObserver(syncStatusStrip).observe(liveCenter, { attributes: true, attributeFilter: ['hidden'] });
		syncStatusStrip();
	}
</script>

<style>
	.dashboard-hero {
		position: relative;
		display: flex;
		min-height: 230px;
		align-items: center;
		justify-content: flex-start;
		overflow: hidden;
		padding: 34px 48px;
		border-radius: 24px 24px 0 0;
		background:
			radial-gradient(ellipse at 75% 5%, rgb(83 119 192 / 38%), transparent 34%),
			linear-gradient(115deg, #111a2e 0%, #1b2a49 62%, #263d68 100%);
		color: #fff;
	}

	.dashboard-hero::after {
		position: absolute;
		right: -42px;
		bottom: -96px;
		width: 390px;
		height: 250px;
		border: 1px solid rgb(255 255 255 / 10%);
		border-radius: 50%;
		content: "";
		transform: rotate(-22deg);
	}

	.dashboard-hero__copy {
		position: relative;
		z-index: 1;
		max-width: 600px;
	}

	.dashboard-hero .eyebrow {
		color: #b9c8e4;
	}

	.dashboard-hero h1 {
		margin: 0;
		font-size: clamp(38px, 6vw, 60px);
		font-weight: 750;
		letter-spacing: -0.065em;
		line-height: 0.98;
	}

	.dashboard-hero h1 span {
		color: #92b6ff;
	}

	.dashboard-hero__copy > p:last-child {
		max-width: 470px;
		margin: 17px 0 0;
		color: #d0d8e8;
		font-size: 15px;
		line-height: 1.6;
	}

	.dashboard-shortcuts {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 22px 0 48px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.dashboard-shortcuts::-webkit-scrollbar {
		display: none;
	}

	.dashboard-shortcuts a {
		display: inline-flex;
		min-height: 44px;
		flex: 0 0 auto;
		align-items: center;
		gap: 9px;
		padding: 0 15px 0 9px;
		border: 1px solid var(--color-border);
		border-radius: 13px;
		background: #fff;
		color: var(--color-ink);
		font-size: 12px;
		font-weight: 650;
		text-decoration: none;
		transition:
			transform 140ms ease,
			box-shadow 140ms ease;
	}

	.dashboard-shortcuts a:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-card);
	}

	.shortcut-icon {
		display: grid;
		width: 26px;
		height: 26px;
		place-items: center;
		border-radius: 8px;
		font-size: 9px;
		font-weight: 800;
	}

	.shortcut-icon--games {
		background: #eaf0fd;
		color: #315cae;
	}

	.shortcut-icon--standings {
		background: #fff0ec;
		color: #b74b32;
	}

	.shortcut-icon--players {
		background: #f0eefe;
		color: #6b56bb;
	}

	.dashboard-section {
		scroll-margin-top: 110px;
		margin-top: 52px;
	}

	#schedule {
		margin-top: 0;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 20px;
	}

	.section-heading .eyebrow {
		margin-bottom: 5px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(23px, 3vw, 30px);
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 1.12;
	}

	.section-kicker {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: #697384;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.09em;
	}

	.section-kicker i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: linear-gradient(90deg, #c23646 50%, #3766b6 50%);
	}

	.schedule-toolbar {
		display: flex;
		width: fit-content;
		max-width: 100%;
		box-sizing: border-box;
		align-items: center;
		justify-content: flex-start;
		gap: 10px;
		margin-bottom: 20px;
		padding: 10px 14px;
		border: 1px solid var(--color-border);
		border-radius: 14px;
		background: linear-gradient(110deg, #fff, #f9faff);
	}

	.schedule-filter {
		display: flex;
		align-items: center;
		gap: 10px 12px;
	}

	.schedule-filter label {
		color: var(--color-muted);
		font-size: 11px;
		font-weight: 650;
	}

	.schedule-filter select {
		max-width: 160px;
		min-height: 38px;
		padding: 0 30px 0 12px;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: #fff;
		color: var(--color-ink);
		font-size: 12px;
	}

	.schedule-filter button,
	.player-search button {
		min-height: 38px;
		padding: 0 18px;
		border: 0;
		border-radius: 10px;
		background: var(--color-navy);
		color: #fff;
		font-size: 12px;
		font-weight: 650;
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 140ms ease;
	}

	.browse-teams {
		margin-left: 4px;
		color: var(--color-blue);
		font-size: 11px;
		font-weight: 650;
		text-decoration: none;
		white-space: nowrap;
	}

	.browse-teams:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.schedule-filter button:hover,
	.player-search button:hover {
		background: #294577;
	}

	.game-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.stale-note {
		margin: 0 0 13px;
		color: #98611d;
		font-size: 12px;
	}

	.section-empty {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 20px 22px;
		border: 1px solid #e9eafa;
		border-radius: 16px;
		background: linear-gradient(105deg, #fff, #f7f7ff);
	}

	.empty-orb {
		display: grid;
		width: 42px;
		height: 42px;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 13px;
		background: #eeedff;
		color: #6656ad;
		font-size: 11px;
		font-weight: 800;
	}

	.section-empty strong {
		font-size: 12px;
	}

	.first-final {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 10px !important;
		padding: 4px 10px;
		border-radius: 999px;
		background: #eeedff;
		color: #4d3f94 !important;
		font-size: 11px;
		font-weight: 650;
	}

	.first-final__time {
		font-variant-numeric: tabular-nums;
		font-weight: 800;
	}

	.section-empty p {
		margin: 4px 0 0;
		color: var(--color-muted);
		font-size: 11px;
	}

	.players-feature {
		padding: 25px;
		border: 1px solid #e5e8f1;
		border-radius: 20px;
		background:
			radial-gradient(ellipse at 98% 4%, rgb(211 218 255 / 43%), transparent 35%),
			linear-gradient(110deg, #fff, #fafaff);
	}

	.players-feature .section-heading {
		margin-bottom: 16px;
	}

	.text-link {
		color: var(--color-blue);
		font-size: 11px;
		font-weight: 650;
		text-decoration: none;
	}

	.text-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.player-search {
		display: flex;
		max-width: 650px;
		min-height: 48px;
		align-items: center;
		gap: 10px;
		margin-bottom: 13px;
		padding: 5px 6px 5px 13px;
		border: 1px solid #e0e3eb;
		border-radius: 13px;
		background: #fff;
		box-shadow: 0 3px 12px rgb(30 40 70 / 4%);
	}

	.player-search > span {
		color: #7772b7;
		font-size: 22px;
		line-height: 1;
	}

	.player-search input {
		width: 100%;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		font-size: 12px;
	}

	.player-search input::placeholder {
		color: #9b9eaa;
	}

	.player-search button {
		flex: 0 0 auto;
		background: #4e488e;
	}

	.player-search button:hover {
		background: #39346e;
	}

	.results-caption {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 15px 0 10px;
		color: var(--color-muted);
		font-size: 11px;
	}

	.player-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 9px;
	}

	.player-card {
