---
import DataState from '../components/DataState.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
	title="NFL games this week"
	description="A clear weekly view of NFL games, with standings and team and player details close at hand."
>
	<div class="page-heading">
		<p class="eyebrow">NFL WEEKEND · WEEKLY OVERVIEW</p>
		<h1>Every game.<br />One clear view.</h1>
		<p>
			Start with the week’s matchups, then go deeper into the teams, players, and numbers behind
			the game.
		</p>
	</div>

	<section class="content-card" aria-labelledby="games-heading">
		<header class="content-card__header">
			<div>
				<h2 id="games-heading">This week’s games</h2>
				<p>Schedule, kickoff times, and game status</p>
			</div>
			<a class="section-link" href="/games">All games <span aria-hidden="true">↗</span></a>
		</header>
		<DataState
			title="The schedule is not connected yet"
			description="Game times and scores will show here after the NFL data source is configured. No game information is being displayed as live or current until then."
		/>
	</section>

	<section class="explore-section" aria-labelledby="explore-heading">
		<div class="explore-section__heading">
			<p class="eyebrow">EXPLORE THE LEAGUE</p>
			<h2 id="explore-heading">More than game day.</h2>
		</div>
		<div class="link-cards">
			<a class="link-card" href="/standings">
				<strong>Standings</strong>
				<span>See how the season is taking shape.</span>
			</a>
			<a class="link-card" href="/teams">
				<strong>Teams</strong>
				<span>Find a team and follow its season.</span>
			</a>
			<a class="link-card" href="/players">
				<strong>Players</strong>
				<span>Explore player profiles and stats.</span>
			</a>
			<a class="link-card" href="/compare">
				<strong>Compare</strong>
				<span>Put teams or players side by side.</span>
			</a>
		</div>
	</section>
</SiteLayout>

<style>
	.section-link {
		flex: 0 0 auto;
		color: var(--color-blue);
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
	}

	.section-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.explore-section {
		margin-top: 54px;
	}

	.explore-section__heading {
		margin-bottom: 18px;
	}

	.explore-section__heading .eyebrow {
		margin-bottom: 7px;
	}

	.explore-section__heading h2 {
		margin: 0;
		font-size: 23px;
		font-weight: 650;
		letter-spacing: -0.04em;
	}

	@media (max-width: 480px) {
		.content-card__header {
			gap: 10px;
		}

		.section-link {
			font-size: 12px;
		}
	}
</style>
