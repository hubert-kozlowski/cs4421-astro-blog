---
import DataFreshness from '../../components/DataFreshness.astro';
import DataState from '../../components/DataState.astro';
import LiveGameCenter from '../../components/LiveGameCenter.astro';
import StadiumDiagram from '../../components/StadiumDiagram.astro';
import TeamMark from '../../components/TeamMark.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
	getApiMetadata,
	getGame,
	getGameBroadcastLabel,
	getGameStatus,
	type ApiResult,
	type NflGame,
	type NflTeam,
} from '../../utils/nfl-data';
import { createGameCalendarEvent } from '../../utils/calendar';
import { getMatchupTypeLabel } from '../../utils/game-presentation';
import { isAbsoluteTimestamp } from '../../utils/local-game-time';
import CalendarActions from '../../components/CalendarActions.astro';

const gameId = Astro.params.gameId ?? '';
let gameResult: ApiResult<NflGame> | undefined;
let teams: NflTeam[] = [];
let metadataResult: ApiResult<{ seasons: number[]; teams: NflTeam[] }> | undefined;
let unavailable = false;
try {
	[gameResult, metadataResult] = await Promise.all([getGame(gameId), getApiMetadata()]);
	teams = metadataResult.value.teams;
} catch (error) {
	unavailable = true;
	console.error(
		JSON.stringify({
			level: 'error',
			event: 'game_detail_unavailable',
			gameId,
			error: error instanceof Error ? error.name : 'UnknownError',
		}),
	);
}

const game = gameResult?.value;
const homeTeam = teams.find((team) => team.abbr === game?.home_team);
const awayTeam = teams.find((team) => team.abbr === game?.away_team);
const hasScore = typeof game?.home_score === 'number' && typeof game.away_score === 'number';
const gameStatus = game ? getGameStatus(game) : 'Scheduled';
const isFinal = gameStatus === 'Final';
const kickoffCandidate = game?.kickoff_at;
const kickoffAt = isAbsoluteTimestamp(kickoffCandidate ?? undefined) ? kickoffCandidate : undefined;
const calendarEvent = game ? createGameCalendarEvent(game, teams) : undefined;
const missingKickoffLabel = gameStatus === 'Scheduled' ? 'Kickoff time pending' : gameStatus;
const broadcastLabel = game ? getGameBroadcastLabel(game) : undefined;
const hasGameDate = Boolean(game?.gameday && Number.isFinite(Date.parse(`${game.gameday}T12:00:00Z`)));
const gameDateTime = kickoffAt ?? (hasGameDate && game?.gameday ? `${game.gameday}T12:00:00Z` : undefined);
const homeScore = typeof game?.home_score === 'number' ? game.home_score : undefined;
const awayScore = typeof game?.away_score === 'number' ? game.away_score : undefined;
const resultSummary = isFinal && homeScore !== undefined && awayScore !== undefined && game
	? homeScore === awayScore
		? 'The game ended in a tie.'
		: homeScore > awayScore
			? `${homeTeam?.name ?? game.home_team} won by ${homeScore - awayScore}.`
			: `${awayTeam?.name ?? game.away_team} won by ${awayScore - homeScore}.`
	: undefined;
const matchupType = getMatchupTypeLabel(game?.game_type, game?.div_game ?? false);
---

<SiteLayout
	title={game ? `${awayTeam?.abbr ?? game.away_team} at ${homeTeam?.abbr ?? game.home_team}` : 'Game details'}
	description="Game date, score, venue, and team details from the NFL Data API."
>
	{game ? (
		<>
			<div class="back-row">
				<a href="/#schedule">← Back to the schedule</a>
				{gameResult && <DataFreshness fetchedAt={gameResult.fetchedAt} stale={gameResult.stale} />}
			</div>
			<section class="game-hero">
				<h1 class="game-hero__title">{awayTeam?.name ?? game.away_team} at {homeTeam?.name ?? game.home_team}</h1>
				<p class="eyebrow">WEEK {game.week ?? '—'} · {game.season ?? 'NFL'} {game.game_type ?? ''}</p>
				<p class="game-hero__date">
					{kickoffAt ? (
						<time datetime={kickoffAt} data-device-time="time">Kickoff time</time>
					) : (
						<>{missingKickoffLabel}</>
					)}
				</p>
				{calendarEvent && <CalendarActions event={calendarEvent} />}
				<div class="game-matchup">
					<a class="game-side" href={awayTeam ? `/teams/${awayTeam.abbr}` : '/teams'}>
						<TeamMark abbr={game.away_team} conference={awayTeam?.conf} size="large" />
						<strong>{awayTeam?.name ?? game.away_team}</strong>
						<span>Away</span>
					</a>
					<div
						class="game-score"
						data-detail-home={game.home_team}
						data-detail-away={game.away_team}
						data-detail-date={game.gameday}
					>
						<strong class:list={{ 'game-score__versus': !hasScore }} data-live-game-score>
							{hasScore ? (
								<>
									<span data-live-away-score>{game.away_score}</span>
									<i>–</i>
									<span data-live-home-score>{game.home_score}</span>
								</>
							) : (
								'VS'
							)}
						</strong>
						<span class:list={['game-status', {
							'game-status--final': isFinal,
							'game-status--score': gameStatus === 'Score posted',
							'game-status--pending': gameStatus === 'Result pending',
						}]} data-game-live-status>
							<span aria-hidden="true"></span>{gameStatus}
						</span>
					</div>
					<a class="game-side" href={homeTeam ? `/teams/${homeTeam.abbr}` : '/teams'}>
						<TeamMark abbr={game.home_team} conference={homeTeam?.conf} size="large" />
						<strong>{homeTeam?.name ?? game.home_team}</strong>
						<span>Home</span>
					</a>
				</div>
			</section>
			<article class="venue-banner" aria-labelledby="venue-heading">
				<StadiumDiagram
					label={game.stadium ?? 'Football stadium'}
					homeTeamName={homeTeam?.name ?? game.home_team ?? 'home team'}
					homeTeamAbbr={game.home_team}
				/>
				<div class="venue-banner__copy">
					<p class="eyebrow">THE VENUE</p>
					<h2 id="venue-heading">{game.stadium ?? 'Stadium to be announced'}</h2>
					<p>
						{homeTeam?.name ? `Home team: ${homeTeam.name}.` : 'Home team shown in team colors.'}
						{game.overtime ? ' · Decided in overtime.' : ''}
					</p>
				</div>
			</article>
			<LiveGameCenter
				homeTeam={game.home_team ?? undefined}
				awayTeam={game.away_team ?? undefined}
				gameDate={game.gameday}
			/>
			<section class="game-information" aria-label="Game information">
				<div
					class="game-snapshot"
					data-game-snapshot
					data-home-name={homeTeam?.name ?? game.home_team ?? 'Home team'}
					data-away-name={awayTeam?.name ?? game.away_team ?? 'Away team'}
				>
					<p class="eyebrow" data-snapshot-eyebrow>{isFinal ? 'THE RESULT' : 'THE MATCHUP'}</p>
					<h2 data-snapshot-title>{isFinal ? 'Final result' : gameStatus === 'Scheduled' ? 'Before kickoff' : 'Game update'}</h2>
					<p class="game-snapshot__summary" data-snapshot-summary>
						{resultSummary ??
							(gameStatus === 'Scheduled'
								? 'The teams are set. Check the kickoff details and venue before game day.'
								: gameStatus === 'Result pending'
									? 'The scheduled kickoff has passed, but a final score has not been posted yet.'
									: 'Follow the matchup here for the latest game status.')}
					</p>
					<dl class="game-facts">
						{gameDateTime && (
							<div>
								<dt>Game day</dt>
								<dd>
									<time
										datetime={gameDateTime}
										data-device-date={kickoffAt ? '' : undefined}
									>
										{kickoffAt
											? 'Game date and kickoff'
											: new Intl.DateTimeFormat('en', {
												weekday: 'long',
												month: 'long',
												day: 'numeric',
												year: 'numeric',
												timeZone: 'UTC',
											}).format(new Date(gameDateTime))}
									</time>
								</dd>
							</div>
						)}
						<div>
							<dt>Week</dt>
							<dd>{game.week ? `Week ${game.week}` : 'To be announced'} · {game.season ?? 'NFL'} season</dd>
						</div>
						{broadcastLabel && (
							<div>
								<dt>Broadcast</dt>
								<dd>{broadcastLabel}</dd>
							</div>
						)}
						<div>
							<dt>Matchup</dt>
							<dd data-snapshot-type>{matchupType}</dd>
						</div>
					</dl>
				</div>
			</section>
		</>
	) : unavailable ? (
		<DataState
			state="error"
			title="Game details could not load"
			description="The game could not be found in the NFL data provider or the provider is temporarily unavailable."
		/>
	) : (
		<DataState state="error" title="Game not found" description="Return to the schedule and choose a game." />
	)}
</SiteLayout>

<script>
	import '../../scripts/game-detail-motion';
</script>

<style>
	.back-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 17px;
	}

	.back-row > a {
		color: var(--color-blue);
		font-size: 12px;
		font-weight: 650;
		text-decoration: none;
	}

	.back-row > a:hover {
		text-decoration: underline;
	}

	.game-hero {
		padding: 28px 32px 33px;
		border-radius: 23px;
		background:
			radial-gradient(ellipse at 50% 120%, rgb(104 137 200 / 31%), transparent 44%),
			linear-gradient(120deg, #111a2e, #243d69);
		color: #fff;
		text-align: center;
	}

	.game-hero__title {
		margin: 0 0 10px;
		color: #fff;
		font-size: clamp(18px, 3vw, 25px);
		font-weight: 800;
		letter-spacing: -0.025em;
	}

	.game-hero .eyebrow {
		color: #aebfdf;
	}

	.game-hero__date {
		margin: 0;
		color: #d1daea;
		font-size: 12px;
	}

	.game-matchup {
		display: grid;
		max-width: 650px;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 23px;
		margin: 27px auto 0;
	}

	.game-side {
		display: grid;
		justify-items: center;
		gap: 9px;
		color: inherit;
		text-decoration: none;
	}

	.game-side strong {
		font-size: 13px;
	}

	.game-side > span:last-child {
		color: #aebbd2;
		font-size: 10px;
	}

	.game-score {
		display: grid;
		min-width: 130px;
		justify-items: center;
		gap: 8px;
	}

	.game-score > strong {
		font-size: 35px;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.06em;
		white-space: nowrap;
	}

	.game-score > strong i {
		color: #9aa9c2;
		font-size: 23px;
		font-style: normal;
	}

	.game-score__versus {
		color: #9eb7e3;
		font-size: 20px !important;
		letter-spacing: 0.15em !important;
	}

	.live-score__value {
		display: inline-block;
	}

	.live-score--changed .live-score__value {
		animation: live-score-flash 1.1s ease-out;
	}

	@keyframes live-score-flash {
		0% {
			color: #ff8287;
			transform: scale(1.18);
		}
		100% {
			color: inherit;
			transform: scale(1);
		}
	}

	.game-status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #9fe0bd;
		font-size: 9px;
		font-weight: 750;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.game-status > span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #59c38a;
	}

	.game-status--final {
		color: #c1cada;
	}

	.game-status--final > span {
		background: #97a4ba;
	}

	.game-status--score {
		color: #f5cf8f;
	}

	.game-status--score > span {
		background: #e9ad56;
	}

	.game-status--pending {
		color: #f2c092;
	}

	.game-status--pending > span {
		background: #d49a65;
	}

	.game-status--live {
		color: #ff9096;
	}

	.game-status--live > span {
		background: #ff4f5b;
		box-shadow: 0 0 0 3px rgb(255 79 91 / 16%);
	}

	.game-information {
		display: block;
		margin-top: 17px;
	}

	.venue-banner,
	.game-snapshot {
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background: #fff;
	}

	.venue-banner {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(220px, 0.75fr);
		align-items: center;
		gap: 18px;
		margin-top: 17px;
		padding: 12px 22px;
	}

	.venue-banner .stadium-diagram {
		width: min(100%, 500px);
		justify-self: center;
	}

	.venue-banner__copy .eyebrow {
		margin-bottom: 5px;
		font-size: 9px;
	}

	.venue-banner__copy h2 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.025em;
	}

	.venue-banner__copy > p:last-child {
		margin: 6px 0 0;
		color: var(--color-muted);
		font-size: 11px;
		line-height: 1.5;
	}

	.game-snapshot {
		padding: 21px 23px;
	}

	.game-snapshot .eyebrow,
	.game-snapshot h2,
	.venue-banner h2 {
		margin: 0;
		font-size: 17px;
		letter-spacing: -0.025em;
	}

	.game-snapshot__summary {
		margin: 7px 0 18px;
		color: var(--color-muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.game-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px 20px;
		margin: 0;
		padding-top: 15px;
		border-top: 1px solid #eef0f3;
	}

	.game-facts div {
		min-width: 0;
	}

	.game-facts dt {
		margin-bottom: 3px;
		color: var(--color-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.game-facts dd {
		margin: 0;
		font-size: 11px;
		font-weight: 650;
		line-height: 1.45;
	}

	@media (max-width: 560px) {
		.game-hero {
			padding: 23px 15px 27px;
		}

		.venue-banner {
			grid-template-columns: 1fr;
			gap: 4px;
			padding: 12px 15px 15px;
		}

		.venue-banner .stadium-diagram {
			width: min(100%, 380px);
		}

		.venue-banner__copy {
			padding: 0 4px;
		}

		.game-snapshot {
			padding: 18px;
		}

		.game-matchup {
			gap: 10px;
		}

		.game-side strong {
			font-size: 10px;
		}

		.game-score {
			min-width: 85px;
		}

		.game-score > strong {
			font-size: 27px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.live-score--changed .live-score__value {
			animation: none;
		}
	}
</style>
