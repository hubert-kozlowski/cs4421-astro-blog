---
import DataFreshness from '../../components/DataFreshness.astro';
import DataState from '../../components/DataState.astro';
import LiveGameCenter from '../../components/LiveGameCenter.astro';
import StadiumDiagram from '../../components/StadiumDiagram.astro';
import TeamMark from '../../components/TeamMark.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
	getApiMetadata,
	buildTeamRecords,
	getGame,
	getGameBroadcastLabel,
	getGameStatus,
	getSeasonGames,
	type ApiResult,
	type NflGame,
	type NflTeam,
	type TeamRecord,
} from '../../utils/nfl-data';
import { createGameCalendarEvent } from '../../utils/calendar';
import { getMatchupTypeLabel } from '../../utils/game-presentation';
import { getStadiumProfile } from '../../utils/stadium-profiles';
import { getTeamDisplayName } from '../../utils/team-names';
import { isAbsoluteTimestamp } from '../../utils/local-game-time';
import CalendarActions from '../../components/CalendarActions.astro';

const gameId = Astro.params.gameId ?? '';
let gameResult: ApiResult<NflGame> | undefined;
let teams: NflTeam[] = [];
let metadataResult: ApiResult<{ seasons: number[]; teams: NflTeam[] }> | undefined;
let seasonGamesResult: ApiResult<{ data: NflGame[]; total: number; limit: number; offset: number }> | undefined;
let recentSeasonResults: ApiResult<{ data: NflGame[]; total: number; limit: number; offset: number }>[] = [];
let unavailable = false;
try {
	[gameResult, metadataResult] = await Promise.all([getGame(gameId), getApiMetadata()]);
	teams = metadataResult.value.teams;
} catch (error) {
	unavailable = true;
	console.error(
		JSON.stringify({
			level: 'error',
			event: 'game_detail_unavailable',
			gameId,
			error: error instanceof Error ? error.name : 'UnknownError',
		}),
	);
}

const game = gameResult?.value;
if (game) {
	const gameSeason = game.season ?? new Date().getUTCFullYear();
	const supplemental = await Promise.allSettled(
		[gameSeason, gameSeason - 1, gameSeason - 2].map((season) => getSeasonGames(season)),
	);
	if (supplemental[0].status === 'fulfilled') seasonGamesResult = supplemental[0].value;
	recentSeasonResults = supplemental.flatMap((result) => result.status === 'fulfilled' ? [result.value] : []);
}
const homeTeam = teams.find((team) => team.abbr === game?.home_team);
const awayTeam = teams.find((team) => team.abbr === game?.away_team);
const homeTeamName = getTeamDisplayName(game?.home_team);
const awayTeamName = getTeamDisplayName(game?.away_team);
const stadiumName = game?.stadium ?? getStadiumProfile(game?.home_team).venue;
const hasScore = typeof game?.home_score === 'number' && typeof game.away_score === 'number';
const gameStatus = game ? getGameStatus(game) : 'Scheduled';
const isFinal = gameStatus === 'Final';
const kickoffCandidate = game?.kickoff_at;
const kickoffAt = isAbsoluteTimestamp(kickoffCandidate ?? undefined) ? kickoffCandidate : undefined;
const calendarEvent = game ? createGameCalendarEvent(game, teams) : undefined;
const missingKickoffLabel = gameStatus === 'Scheduled' ? 'Kickoff time pending' : gameStatus;
const broadcastLabel = game ? getGameBroadcastLabel(game) : undefined;
const hasGameDate = Boolean(game?.gameday && Number.isFinite(Date.parse(`${game.gameday}T12:00:00Z`)));
const gameDateTime = kickoffAt ?? (hasGameDate && game?.gameday ? `${game.gameday}T12:00:00Z` : undefined);
const homeScore = typeof game?.home_score === 'number' ? game.home_score : undefined;
const awayScore = typeof game?.away_score === 'number' ? game.away_score : undefined;
const resultSummary = isFinal && homeScore !== undefined && awayScore !== undefined && game
	? homeScore === awayScore
		? 'The game ended in a tie.'
		: homeScore > awayScore
			? `${homeTeamName} won by ${homeScore - awayScore}.`
			: `${awayTeamName} won by ${awayScore - homeScore}.`
	: undefined;
const matchupType = getMatchupTypeLabel(game?.game_type, game?.div_game ?? false);
const teamRecords = seasonGamesResult
	? buildTeamRecords(seasonGamesResult.value.data, teams)
	: [];
const homeRecord = teamRecords.find((record) => record.abbr === game?.home_team);
const awayRecord = teamRecords.find((record) => record.abbr === game?.away_team);
const gameSortTime = (candidate: NflGame) => {
	if (isAbsoluteTimestamp(candidate.kickoff_at ?? undefined)) return Date.parse(candidate.kickoff_at!);
	if (candidate.gameday) return Date.parse(`${candidate.gameday}T12:00:00Z`);
	return Number.NaN;
};
const currentGameTime = game ? gameSortTime(game) : Number.NaN;
const lastCompletedGame = (team: string | null | undefined) => seasonGamesResult?.value.data
	.filter((candidate) => {
		if (!team || candidate.game_id === game?.game_id) return false;
		if (candidate.home_team !== team && candidate.away_team !== team) return false;
		if (typeof candidate.home_score !== 'number' || typeof candidate.away_score !== 'number') return false;
		const candidateTime = gameSortTime(candidate);
		return Number.isFinite(candidateTime) && (!Number.isFinite(currentGameTime) || candidateTime < currentGameTime);
	})
	.sort((left, right) => gameSortTime(right) - gameSortTime(left))[0];
const homeLastGame = lastCompletedGame(game?.home_team);
const awayLastGame = lastCompletedGame(game?.away_team);
const recordLabel = (record: TeamRecord | undefined) => record
	? `${record.wins}-${record.losses}${record.ties ? `-${record.ties}` : ''}`
	: 'Record unavailable';
const lastGameLabel = (candidate: NflGame | undefined, team: string | null | undefined) => {
	if (!candidate || !team || typeof candidate.home_score !== 'number' || typeof candidate.away_score !== 'number') {
		return 'No completed game in the provider yet';
	}
	const isHome = candidate.home_team === team;
	const teamScore = isHome ? candidate.home_score : candidate.away_score;
	const opponentScore = isHome ? candidate.away_score : candidate.home_score;
	const opponent = isHome ? candidate.away_team : candidate.home_team;
	const result = teamScore === opponentScore ? 'T' : teamScore > opponentScore ? 'W' : 'L';
	return `${result} ${teamScore}-${opponentScore} vs ${getTeamDisplayName(opponent)}`;
};
const recentMeetings = Array.from(new Map(recentSeasonResults
	.flatMap((result) => result.value.data)
	.filter((candidate) => {
		const matchesPair = candidate.away_team === game?.away_team && candidate.home_team === game?.home_team
			|| candidate.away_team === game?.home_team && candidate.home_team === game?.away_team;
		return matchesPair && typeof candidate.away_score === 'number' && typeof candidate.home_score === 'number';
	})
	.map((candidate) => [candidate.game_id, candidate])).values());
const recentSeriesRecord = (team: string | null | undefined) => recentMeetings.reduce((record, candidate) => {
	if (!team) return record;
	const teamScore = candidate.home_team === team ? candidate.home_score : candidate.away_score;
	const opponentScore = candidate.home_team === team ? candidate.away_score : candidate.home_score;
	if (teamScore === opponentScore) record.ties += 1;
	else if ((teamScore ?? 0) > (opponentScore ?? 0)) record.wins += 1;
	else record.losses += 1;
	return record;
}, { wins: 0, losses: 0, ties: 0 });
const awayRecentRecord = recentSeriesRecord(game?.away_team);
const homeRecentRecord = recentSeriesRecord(game?.home_team);
const supplementalStale = recentSeasonResults.some((result) => result.stale);
const freshestFetchedAt = [gameResult?.fetchedAt, ...recentSeasonResults.map((result) => result.fetchedAt)]
	.filter((value): value is string => Boolean(value))
	.sort((left, right) => Date.parse(right) - Date.parse(left))[0];
const recentSeriesAvailable = recentMeetings.length > 0;
const recentSeasonStart = (game?.season ?? new Date().getUTCFullYear()) - 2;
const recentSeasonEnd = game?.season ?? new Date().getUTCFullYear();
const scheduledSummary = `${awayTeamName} visits ${homeTeamName}${stadiumName ? ` at ${stadiumName}` : ''} for this ${matchupType.toLowerCase()}.`;
---

<SiteLayout
	title={game ? `${awayTeamName} at ${homeTeamName}` : 'Game details'}
	description="Game date, score, venue, and team details from the NFL Data API."
>
	{game ? (
		<>
			<div class="back-row">
				<a href="/#schedule">← Back to the schedule</a>
				{freshestFetchedAt && <DataFreshness fetchedAt={freshestFetchedAt} stale={Boolean(gameResult?.stale || supplementalStale)} />}
			</div>
			<section class="game-hero">
				<div class="game-hero__meta">
					<span>NFL · WEEK {game.week ?? '—'}</span>
					<span>{broadcastLabel ?? matchupType}</span>
				</div>
				<div class="game-hero__heading">
					<p class="eyebrow">{isFinal ? 'FINAL' : gameStatus === 'Scheduled' ? 'UPCOMING MATCHUP' : 'GAME CENTER'}</p>
					<h1 class="game-hero__title">{awayTeamName} <span>at</span> {homeTeamName}</h1>
					<p class="game-hero__date">
						{kickoffAt ? (
							<time datetime={kickoffAt} data-device-time="time">Kickoff time</time>
						) : (
							<>{missingKickoffLabel}</>
						)}
					</p>
					{calendarEvent && <CalendarActions event={calendarEvent} />}
				</div>
				<div class="game-matchup">
					<a class="game-side" href={awayTeam ? `/teams/${awayTeam.abbr}` : '/teams'}>
						<TeamMark abbr={game.away_team} conference={awayTeam?.conf} size="large" />
						<span class="game-side__copy">
							<strong>{awayTeamName}</strong>
							<small>{recordLabel(awayRecord)} · Away</small>
						</span>
					</a>
					<div
						class="game-score"
						data-detail-home={game.home_team}
						data-detail-away={game.away_team}
						data-detail-date={game.gameday}
					>
						<strong class:list={{ 'game-score__versus': !hasScore }} data-live-game-score>
							{hasScore ? (
								<>
									<span data-live-away-score>{game.away_score}</span>
									<i>–</i>
									<span data-live-home-score>{game.home_score}</span>
								</>
							) : (
								'VS'
							)}
						</strong>
						<span class:list={['game-status', {
							'game-status--final': isFinal,
							'game-status--score': gameStatus === 'Score posted',
							'game-status--pending': gameStatus === 'Result pending',
						}]} data-game-live-status>
							<span aria-hidden="true"></span>{gameStatus}
						</span>
					</div>
					<a class="game-side" href={homeTeam ? `/teams/${homeTeam.abbr}` : '/teams'}>
						<TeamMark abbr={game.home_team} conference={homeTeam?.conf} size="large" />
						<span class="game-side__copy">
							<strong>{homeTeamName}</strong>
							<small>{recordLabel(homeRecord)} · Home</small>
						</span>
					</a>
				</div>
			</section>
			<LiveGameCenter
				homeTeam={game.home_team ?? undefined}
				awayTeam={game.away_team ?? undefined}
				gameDate={game.gameday}
			/>
			<section class="matchup-briefing" aria-labelledby="briefing-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">TEAM CONTEXT</p>
						<h2 id="briefing-heading">{gameStatus === 'Scheduled' ? 'Matchup briefing' : 'Matchup context'}</h2>
					</div>
					{supplementalStale && <span>Context may be delayed</span>}
				</div>
				<div class="matchup-briefing__grid">
					<article class="team-context-card">
						<div class="team-context-card__heading">
							<TeamMark abbr={game.away_team} conference={awayTeam?.conf} size="small" />
							<div><span>Away team</span><h3>{awayTeamName}</h3></div>
							<strong>{recordLabel(awayRecord)}</strong>
						</div>
						<p><span>Last time out</span>{lastGameLabel(awayLastGame, game.away_team)}</p>
					</article>
					<article class="series-card">
						<span>Last 3 seasons</span>
						{recentSeriesAvailable ? (
							<>
								<strong>{game.away_team} {awayRecentRecord.wins}–{homeRecentRecord.wins} {game.home_team}</strong>
								<p>{recentMeetings.length} {recentMeetings.length === 1 ? 'meeting' : 'meetings'} in provider data · {recentSeasonStart}–{recentSeasonEnd}{awayRecentRecord.ties ? ` · ${awayRecentRecord.ties} tied` : ''}</p>
							</>
						) : (
							<><strong>—</strong><p>No meetings found from {recentSeasonStart}–{recentSeasonEnd}</p></>
						)}
					</article>
					<article class="team-context-card">
						<div class="team-context-card__heading">
							<TeamMark abbr={game.home_team} conference={homeTeam?.conf} size="small" />
							<div><span>Home team</span><h3>{homeTeamName}</h3></div>
							<strong>{recordLabel(homeRecord)}</strong>
						</div>
						<p><span>Last time out</span>{lastGameLabel(homeLastGame, game.home_team)}</p>
					</article>
				</div>
			</section>
			<section class="game-information" aria-label="Game information">
				<div
					class="game-snapshot"
					data-game-snapshot
					data-home-name={homeTeamName}
					data-away-name={awayTeamName}
				>
					<p class="eyebrow" data-snapshot-eyebrow>{isFinal ? 'THE RESULT' : 'THE MATCHUP'}</p>
					<h2 data-snapshot-title>{isFinal ? 'Final result' : gameStatus === 'Scheduled' ? 'Before kickoff' : 'Game update'}</h2>
					<p class="game-snapshot__summary" data-snapshot-summary>
						{resultSummary ??
							(gameStatus === 'Scheduled'
								? scheduledSummary
								: gameStatus === 'Result pending'
									? 'The scheduled kickoff has passed, but a final score has not been posted yet.'
									: 'Follow the matchup here for the latest game status.')}
					</p>
					<dl class="game-facts">
						{gameDateTime && (
							<div>
								<dt>Game day</dt>
								<dd>
									<time
										datetime={gameDateTime}
										data-device-date={kickoffAt ? '' : undefined}
									>
										{kickoffAt
											? 'Game date and kickoff'
											: new Intl.DateTimeFormat('en', {
												weekday: 'long',
												month: 'long',
												day: 'numeric',
												year: 'numeric',
												timeZone: 'UTC',
											}).format(new Date(gameDateTime))}
									</time>
								</dd>
							</div>
						)}
						<div>
							<dt>Week</dt>
							<dd>{game.week ? `Week ${game.week}` : 'To be announced'} · {game.season ?? 'NFL'} season</dd>
						</div>
						{broadcastLabel && (
							<div>
								<dt>Broadcast</dt>
								<dd>{broadcastLabel}</dd>
							</div>
						)}
						<div>
							<dt>Matchup</dt>
							<dd data-snapshot-type>{matchupType}</dd>
						</div>
						<div>
							<dt>Venue</dt>
							<dd>{stadiumName}</dd>
						</div>
					</dl>
				</div>
				<article class="venue-banner" aria-labelledby="venue-heading">
					<StadiumDiagram
						label={game.stadium ?? undefined}
						homeTeamName={homeTeamName}
						homeTeamAbbr={game.home_team}
					/>
					<div class="venue-banner__copy">
						<p class="eyebrow">THE VENUE</p>
						<h2 id="venue-heading">{stadiumName}</h2>
						<p>Home field for the {homeTeamName}.{game.overtime ? ' This game went to overtime.' : ''}</p>
					</div>
				</article>
			</section>
		</>
	) : unavailable ? (
		<DataState
			state="error"
			title="Game details could not load"
			description="The game could not be found in the NFL data provider or the provider is temporarily unavailable."
		/>
	) : (
		<DataState state="error" title="Game not found" description="Return to the schedule and choose a game." />
	)}
</SiteLayout>

<script>
	import '../../scripts/game-detail-motion';
</script>

<style>
	.back-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 17px;
	}

	.back-row > a {
		color: var(--sport-accent-strong);
		font-size: 12px;
		font-weight: 650;
		text-decoration: none;
	}

	.back-row > a:hover {
		text-decoration: underline;
	}

	.game-hero {
		position: relative;
		overflow: hidden;
		padding: 28px 32px 33px;
		border-radius: 23px;
		background:
			radial-gradient(ellipse at 50% 120%, rgb(104 137 200 / 34%), transparent 44%),
			radial-gradient(ellipse at 0 0, rgb(79 110 164 / 20%), transparent 42%),
			linear-gradient(120deg, #111a2e, #243d69);
		color: #fff;
		text-align: center;
	}

	.game-hero::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 3px;
		background: linear-gradient(90deg, #c33748 0 50%, #3a65b6 50%);
		content: "";
		opacity: 0.9;
	}

	.game-hero__title {
		margin: 0 0 10px;
		color: #fff;
		font-size: clamp(18px, 3vw, 25px);
		font-weight: 800;
		letter-spacing: -0.025em;
	}

	.game-hero .eyebrow {
		color: #aebfdf;
	}

	.game-hero__date {
		margin: 0;
		color: #d1daea;
		font-size: 12px;
	}

	.game-matchup {
		display: grid;
		width: min(100%, 680px);
		max-width: 680px;
		grid-template-columns: minmax(0, 1fr) 112px minmax(0, 1fr);
		align-items: center;
		gap: clamp(12px, 2.2vw, 22px);
		margin: 22px auto 0;
	}

	.game-side {
		display: grid;
		width: 100%;
		min-width: 0;
		min-height: 148px;
		justify-items: center;
		align-content: center;
		gap: 10px;
		box-sizing: border-box;
		padding: 18px 20px 16px;
		border: 1px solid rgb(255 255 255 / 19%);
		border-radius: 18px;
		background:
			radial-gradient(ellipse at 50% 0, rgb(255 255 255 / 12%), transparent 70%),
			linear-gradient(145deg, rgb(255 255 255 / 13%), rgb(255 255 255 / 7%));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 9%), 0 8px 24px rgb(0 0 0 / 12%);
		color: inherit;
		text-decoration: none;
		transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
	}

	.game-side:hover {
		border-color: rgb(255 255 255 / 32%);
		background:
			radial-gradient(ellipse at 50% 0, rgb(255 255 255 / 17%), transparent 70%),
			linear-gradient(145deg, rgb(255 255 255 / 17%), rgb(255 255 255 / 10%));
		transform: translateY(-2px);
	}

	.game-side :global(.team-mark--large) {
		width: 82px;
		height: 82px;
		filter: drop-shadow(0 5px 9px rgb(0 0 0 / 20%));
	}

	.game-side strong {
		max-width: 100%;
		font-size: 13px;
		line-height: 1.35;
		overflow-wrap: anywhere;
		text-wrap: balance;
	}

	.game-side > span:last-child {
		color: #aebbd2;
		font-size: 10px;
	}

	.game-score {
		display: grid;
		width: 112px;
		box-sizing: border-box;
		min-width: 0;
		justify-items: center;
		gap: 8px;
		padding: 13px 15px;
		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: 16px;
		background: linear-gradient(160deg, rgb(8 16 31 / 70%), rgb(8 16 31 / 54%));
		box-shadow: 0 8px 22px rgb(0 0 0 / 18%);
		z-index: 1;
	}

	.game-score > strong {
		font-size: 35px;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.06em;
		white-space: nowrap;
	}

	.game-score > strong i {
		color: #9aa9c2;
		font-size: 23px;
		font-style: normal;
	}

	.game-score__versus {
		color: #9eb7e3;
		font-size: 20px !important;
		letter-spacing: 0.15em !important;
	}

	.live-score__value {
		display: inline-block;
	}

	.live-score--changed:not(.live-score--touchdown) .live-score__value {
		animation: live-score-flash 1.1s ease-out;
	}

	@keyframes live-score-flash {
		0% {
			color: #ff8287;
			transform: scale(1.18);
		}
		100% {
			color: inherit;
			transform: scale(1);
		}
	}

	.game-status {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
		color: #9fe0bd;
		font-size: 9px;
		font-weight: 750;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		text-align: center;
		overflow-wrap: anywhere;
	}

	.game-status > span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #59c38a;
	}

	.game-status--final {
		color: #c1cada;
	}

	.game-status--final > span {
		background: #97a4ba;
	}

	.game-status--score {
		color: #f5cf8f;
	}

	.game-status--score > span {
		background: #e9ad56;
	}

	.game-status--pending {
		color: #f2c092;
	}

	.game-status--pending > span {
		background: #d49a65;
	}

	.game-status--live {
		color: #ff9096;
	}

	.game-status--live > span {
		background: #ff4f5b;
		box-shadow: 0 0 0 3px rgb(255 79 91 / 16%);
	}

	.game-information {
		display: block;
		margin-top: 17px;
	}

	.venue-banner,
	.game-snapshot {
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background: #fff;
	}

	.venue-banner {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		gap: 10px;
		margin-top: 17px;
		padding: 20px 24px 22px;
		text-align: center;
	}

	.venue-banner__copy {
		max-width: 560px;
	}

	.venue-banner .stadium-diagram {
		width: min(100%, 560px);
		justify-self: center;
	}

	.venue-banner__copy .eyebrow {
		margin-bottom: 5px;
		font-size: 9px;
	}

	.venue-banner__copy h2 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.025em;
	}

	.venue-banner__copy > p:last-child {
		margin: 6px 0 0;
		color: var(--color-muted);
		font-size: 11px;
		line-height: 1.5;
	}

	.game-snapshot {
		padding: 18px 20px;
	}

	.game-snapshot .eyebrow,
	.game-snapshot h2,
	.venue-banner h2 {
		margin: 0;
		font-size: 17px;
		letter-spacing: -0.025em;
	}

	.game-snapshot__summary {
		margin: 7px 0 14px;
		color: var(--color-muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.game-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px 18px;
		margin: 0;
		padding-top: 15px;
		border-top: 1px solid #eef0f3;
	}

	.game-facts div {
		min-width: 0;
	}

	.game-facts dt {
